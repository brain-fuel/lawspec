{
  "name": "lawspec",
  "version": "0.36.0",
  "description": "State the law once. Check it everywhere.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brain-fuel/lawspec.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lawspec": "bin/lawspec.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./api.mjs"
    }
  },
  "types": "index.d.ts",
  "devDependencies": {"@modelcontextprotocol/server": "2.4.0", "edn-data": "1.2.2", "tar": "7.5.22", "zod": "4.6.7"},
  "optionalDependencies": {
    "ricestax": "0.4.3",
    "wasm-platform-kit": "0.2.0",
    "@goforgedev/compiler-darwin-arm64": "0.36.0",
    "@goforgedev/compiler-darwin-x64": "0.36.0",
    "@goforgedev/compiler-linux-arm64": "0.36.0",
    "@goforgedev/compiler-linux-x64": "0.36.0",
    "@goforgedev/canon-darwin-arm64": "0.36.0",
    "@goforgedev/canon-darwin-x64": "0.36.0",
    "@goforgedev/canon-linux-arm64": "0.36.0",
    "@goforgedev/canon-linux-x64": "0.36.0"
  },
  "files": [
             "api.mjs",
             "launcher.mjs",
             "host-launcher.mjs",
             "host-codecs.mjs",
             "host.mjs",
             "worker.mjs",
             "postinstall.mjs",
             "*.json",
             "index.d.ts",
             "bin",
             "host-core.wasm",
             "core.wasm",
             "core.wasm.gz",
             "core_jsffi.js",
             "host-component",
             "go.mod",
             "README.md",
             "CHANGELOG.md",
             "LICENSE",
             "UNICODE-LICENSE.txt",
             "NORMALIZATION-LICENSES.txt",
             "starter.lawspec",
             "starter-rc1.lawspec",
             "examples",
             "learn"
           ],
  "scripts": {
    "postinstall": "node postinstall.mjs",
    "prepack": "for f in README.md CHANGELOG.md; do cmp -s ../$f $f || { cp ../$f .$f.$$ && mv -f .$f.$$ $f; }; done",
    "test": "node --test test/*.test.mjs"
  }
}
