      "types": "./index.d.ts",
      "import": "./api.mjs"
    }
  },
  "types": "index.d.ts",
  "files": [
             "*.mjs",
             "*.json",
             "index.d.ts",
             "bin",
             "core.wasm",
             "core_jsffi.js",
             "README.md",
             "CHANGELOG.md",
             "LICENSE",
             "starter.lawspec",
             "examples"
           ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
