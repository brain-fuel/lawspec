{
  "name": "lawspec",
  "version": "0.17.0",
  "description": "State the law once. Check it everywhere.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brain-fuel/lawspec.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lawspec": "bin/lawspec.mjs"
  },
