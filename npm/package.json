{
  "name": "lawspec",
  "version": "0.31.0",
  "description": "State the law once. Check it everywhere.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brain-fuel/lawspec.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lawspec": "bin/lawspec.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./api.mjs"
    },
    "./proof": {
      "types": "./proof.d.ts",
      "import": "./proof.mjs"
    },
    "./component": {
      "types": "./component.d.ts",
      "import": "./component.mjs"
    }
  },
  "types": "index.d.ts",
  "dependencies": {"edn-data": "1.2.2", "tar": "7.5.22"},
  "files": [
             "*.mjs",
             "*.json",
             "*.d.ts",
             "bin",
             "core.wasm",
             "core_jsffi.js",
             "go.mod",
             "README.md",
             "CHANGELOG.md",
             "LICENSE",
             "UNICODE-LICENSE.txt",
             "NORMALIZATION-LICENSES.txt",
             "starter.lawspec",
             "starter-rc1.lawspec",
             "examples"
           ],
  "scripts": {
    "prepack": "for f in README.md CHANGELOG.md; do cmp -s ../$f $f || { cp ../$f .$f.$$ && mv -f .$f.$$ $f; }; done",
    "test": "node --test test/*.test.mjs"
  }
}
