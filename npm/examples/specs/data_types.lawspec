unit example.data_types

type Pair (a :: Type) (b :: Type) is a record{

    first :: a
    second :: b}
end type

type Tree (a :: Type) is one of
  Leaf  of type a
  Branch  of type List (Tree a)
end type

law "|products preserve every field| is
  definition :
    for all (pair :: Pair Int8 Bool) =>
      (first matching case of pair :
        when Pair record{ first = first , second = second} then Pair record{ first = first , second = second}
      end case) = pair end for all
  end definition
  example "|maximum integer and false| :
    pair = Pair record{ first = 127 , second = false}
    expect pair = Pair record{ first = 127 , second = false}
  end example
end law

law "|sums preserve constructor identity and payloads| is
  definition :
    for all (tree :: Tree Int8) =>
      (first matching case of tree :
        when Leaf value then Leaf value
        when Branch children then Branch children
      end case) = tree end for all
  end definition
  example "|nested branches| :
    tree = Branch [Leaf 127, Branch [], Leaf -128]
    expect tree = Branch [Leaf 127, Branch [], Leaf -128]
  end example
end law


-- A refined type argument constrains the corresponding stored fields. This
-- predicate becomes a scoped Core traversal, shared by all eight backends.
refinement Positive is (value :: Int8 where value > 0) end refinement

function positivePair (value :: Positive) -> Pair Positive Bool is
  Pair record{ first = value , second = true}
end function

function reciprocalFirst (pair :: Pair Positive Bool) -> Rational is
  first matching case of pair :
    when Pair record{ first = first , second = second} then 1 / first
  end case
end function

law "|named payload contracts justify exact division| is
  definition :
    for all (value :: Positive) =>
      reciprocalFirst (positivePair value) = 1 / value end for all
  end definition
  example "|one half| :
    value = 2
    expect positivePair value = Pair record{ first = 2 , second = true}
    expect reciprocalFirst (positivePair value) = rational(1, 2)
  end example
end law
end unit
