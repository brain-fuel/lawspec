unit example.scalar_adapters
echoChar :: Char -> Char
echoCodePoint :: CodePoint -> CodePoint
echoCodeUnit :: CodeUnit16 -> CodeUnit16
echoBytes :: Bytes -> Bytes
echoComplex :: Complex64 -> Complex64
successor :: Int8 -> Integer
narrow :: Int8 -> Int8
addDecimal :: Decimal -> Decimal -> Decimal
sameSymbol :: Symbol -> Symbol -> Bool
echoRaw :: Utf16Text -> Utf16Text
echoPresence :: Optional (Nullable Int8) -> Optional (Nullable Int8)
finish :: Unit -> Unit
preserveBig :: UInt64 -> UInt64
machineEcho :: IntSize -> IntSize

law "|promoted successor| is
  definition : for all (x :: Int8) => successor x = x + 1 end for all end definition
  example "|no overflow| : x = 127 expect successor x = 128 end example
end law
law "|checked bridge| is
  definition : for all (x :: Int8) => narrow (x + 0) = x end for all end definition
  example "|maximum| : x = 127 expect narrow (x + 0) = 127 end example
end law
law "|exact decimal adapter| is
  definition : for all (x :: Decimal) (y :: Decimal) => addDecimal x y = x + y end for all end definition
  example "|tenths| : x = 0.1 y = 0.2 expect addDecimal x y = 0.3 end example
end law
law "|symbol identity adapter| is
  definition : for all (x :: Symbol) (y :: Symbol) => sameSymbol x x and sameSymbol y y end for all end definition
  example "|same description distinct identities| :
    x = symbol("a", "same") y = symbol("b", "same")
    expect sameSymbol x y = false
    expect sameSymbol x x = true
  end example
end law
law "|raw adapter| is
  definition : for all (x :: Utf16Text) => echoRaw x = x end for all end definition
  example "|lone surrogate| : x = utf16([55296]) expect echoRaw x = utf16([55296]) end example
end law
law "|presence adapter| is
  definition : for all (x :: Optional (Nullable Int8)) => echoPresence x = x end for all end definition
  example "|missing| : x = undefined expect echoPresence x = undefined end example
  example "|null present| : x = optional(null) expect echoPresence x = optional(null) end example
end law
law "|unit adapter| is
  definition : for all (x :: Unit) => finish x = unitValue end for all end definition
  example "|completed| : x = unitValue expect finish x = unitValue end example
end law

law "|no safe-number truncation| is
  definition : for all (x :: UInt64) => preserveBig x = x end for all end definition
  example "|unsigned maximum| : x = 18446744073709551615 expect preserveBig x = 18446744073709551615 end example
end law
law "|machine profile binding| is
  definition : for all (x :: IntSize) => machineEcho x = x end for all end definition
  example "|portable width| : x = 2147483647 expect machineEcho x = 2147483647 end example
end law

law "|Char native bridge| is
  definition : for all (x :: Char) => echoChar x = x end for all end definition
  example "|native value| : x = char(128512) expect echoChar x = char(128512) end example
end law

law "|CodePoint native bridge| is
  definition : for all (x :: CodePoint) => echoCodePoint x = x end for all end definition
  example "|native value| : x = codePoint(55296) expect echoCodePoint x = codePoint(55296) end example
end law

law "|CodeUnit16 native bridge| is
  definition : for all (x :: CodeUnit16) => echoCodeUnit x = x end for all end definition
  example "|native value| : x = codeUnit16(65535) expect echoCodeUnit x = codeUnit16(65535) end example
end law

law "|Bytes native bridge| is
  definition : for all (x :: Bytes) => echoBytes x = x end for all end definition
  example "|native value| : x = bytes([0,128,255]) expect echoBytes x = bytes([0,128,255]) end example
end law

law "|Complex64 native bridge| is
  definition : for all (x :: Complex64) => prelude.isNaN (prelude.real (echoComplex x)) = prelude.isNaN (prelude.real x) end for all end definition
  example "|native value| : x = complex64(1,2) expect echoComplex x = complex64(1,2) end example
end law
end unit
