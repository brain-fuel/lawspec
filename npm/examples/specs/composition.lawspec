unit example.composition

-- A log store seen through two abilities, Logs and Reader. One spec handler
-- answers both from one state, and a set of handlers runs every law over
-- the spec handlers together. The native handlers share a Store: each case
-- opens one, and every native handler of the case is made with it.

type Problem is | UnknownLog | EmptyRecord end

type Log is
  Log
    records :: List Text
    appends :: Int64
end

handle Store

openStore :: Unit -> Store
closeStore :: Store -> Unit

resource Store is
  acquire is openStore unitValue end
  release store is closeStore store end
end

ability Logs with Store is
  create :: Text -> Unit
  append :: Text -> Text -> Int64 fails with Problem
laws
  law `a new log takes its first record at offset zero` is
    definition is `for all` (t :: Text) (r :: Text where r != "") . (create t; append t r) = 0 end
  end
  law `an unknown log refuses records` is
    definition is `for all` (t :: Text) (r :: Text) . append t r fails with UnknownLog end
  end
end

ability Reader with Store is
  size :: Text -> Maybe Int64
laws
  law `an unknown log has no size` is
    definition is `for all` (t :: Text) . size t = Nothing end
  end
end

-- A client over Logs: it keeps the offset of its last write.
ability Writer with Store is
  write :: Text -> Text -> Bool
  lastOffset :: Maybe Int64
laws
  law `a write to a new log is read back` is
    definition is
      `for all` (t :: Text) (r :: Text where r != "") . (create t; write t r; size t) = Just 1
    end
  end
end

definition empty (u :: Unit) :: KeyVal Text Log is prelude.keyValOf [] end

-- One state for both abilities. It starts from a computed value, and the
-- clause for append updates it in one branch only.
handler store for Logs, Reader with state logs :: KeyVal Text Log start empty unitValue is
  create t is ~logs := prelude.put t (Log [] 0) logs; unitValue end
  append t r is
    match prelude.lookup t logs with
    | Nothing -> raise UnknownLog
    | Just log ->
        if r == "" then raise EmptyRecord else
          (~logs := prelude.put t (log with records = Cons r log.records, appends = prelude.saturating (log.appends + 1)) logs;
           log.appends)
    end
  end
  size t is
    match prelude.lookup t logs with
    | Nothing -> Nothing
    | Just log -> Just log.appends
    end
  end
end

-- A clause may be a definition that gives Pair result state: `op by f`.
definition writeTo (t :: Text) (r :: Text) (last :: Maybe Int64) :: Pair Bool (Maybe Int64) uses Logs is
  match prelude.attempt (append t r) with
  | Left problem -> Pair false last
  | Right offset -> Pair true (Just offset)
  end
end

definition lastOf (last :: Maybe Int64) :: Pair (Maybe Int64) (Maybe Int64) is Pair last last end

handler logWriter for Writer with state last :: Maybe Int64 start Nothing is
  write by writeTo
  lastOffset by lastOf
end

-- The reference composition: every ability answered by spec handlers.
handlers reference is store, logWriter end

law `sizes count records` is
  definition is
    `for all` (t :: Text) (a :: Text where a != "") (b :: Text where b != "") .
      (create t; append t a; append t b; size t) = Just 2
  end
end

law `a writer remembers where it wrote` is
  definition is
    `for all` (t :: Text) (r :: Text where r != "") . (create t; write t r; lastOffset) = Just 0
  end
end
