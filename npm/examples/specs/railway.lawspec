unit example.railway

-- Railway combinators on Either. Each symbol has a prelude name, and both are
-- rewritten into matches, so they work in laws and checked definitions alike.

type Problem is one of | TooSmall | TooLarge | Odd end type

function positive (x :: Integer) -> Either Problem Integer is
  prelude.select (x > 0) (Right x) (Left TooSmall)
end function

function small (x :: Integer) -> Either Problem Integer is
  prelude.select (x < 100) (Right x) (Left TooLarge)
end function

function even (x :: Integer) -> Bool is prelude.rem x 2 = 0 end function

function twice (x :: Integer) -> Integer is x + x end function

function retry (p :: Problem) -> Either Problem Integer is Right 1 end function

-- A checked pipeline written with symbols: positive, then small, then doubled.
function checked (x :: Integer) -> Either Problem Integer is
  twice <$> (positive x >>= small)
end function

-- The same pipeline in English.
function checkedInWords (x :: Integer) -> Either Problem Integer is
  prelude.map twice (prelude.bind (positive x) small)
end function

law "|symbols and English agree| is
  definition : for all (x :: Integer) => checked x = checkedInWords x end for all end definition
end law

law "|binding associates| is
  definition :
    for all (x :: Integer) => ((positive x >>= small) >>= positive) = (positive x >>= (small >=> positive)) end for all
  end definition
end law

law "|a failure short-circuits| is
  definition : for all (x :: Integer) => x <= 0 implies checked x = Left TooSmall end for all end definition
end law

law "|recovery replaces a failure| is
  definition : for all (x :: Integer) => (positive x <|> retry) = prelude.select (x > 0) (Right x) (Right 1) end for all end definition
end law

law "|ensure keeps even values| is
  definition :
    for all (x :: Integer) =>
      prelude.ensure even Odd (positive x) = prelude.select (x > 0) (prelude.select (even x) (Right x) (Left Odd)) (Left TooSmall) end for all
  end definition
end law

law "|both pairs successes| is
  definition :
    for all (x :: Integer) => prelude.isRight (positive x <*> small x) = (x > 0 && x < 100) end for all
  end definition
end law

-- The prelude's railway laws, instantiated for these definitions.
law "|positive is a left identity case| is
  definition : apply law "|bind has a left identity| positive end definition
end law

law "|positive, small and positive associate| is
  definition : apply law "|bind is associative| positive small positive end definition
end law

law "|mapping twice fuses| is
  definition : apply law "|map fuses| positive twice twice end definition
end law

law "|retry keeps successes| is
  definition : apply law "|recovery keeps successes| positive retry end definition
end law
end unit
