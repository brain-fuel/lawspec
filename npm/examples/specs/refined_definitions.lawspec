unit example.refined_definitions

refinement Nonzero (T :: Type) requires Integer T is
  (value :: T where value != 0)
end refinement

-- The compiler proves division is defined under the input contract.
-- Native callers are checked before the body runs.
function reciprocal (x :: Nonzero a) -> Rational
requires Integer a
is
  1 / x
end function

-- Arithmetic promotes before this explicit, proved narrowing conversion.
function increment (x :: Int8 where x < 127)
  -> (result :: Int8 where result > x)
is
  prelude.Int8 (x + 1)
end function

-- Later argument refinements can depend on earlier arguments.
function inverseGap (x :: Int8) (y :: Int8 where y > x) -> Rational is
  1 / (y - x)
end function

law "|exact reciprocal| is
  definition : for all (x :: Nonzero Int8) => reciprocal x = 1 / x end for all end definition
  example "|one half| : x = 2 expect reciprocal x = rational(1, 2) end example
end law

law "|checked increment| is
  definition : for all (x :: Int8 where x < 127) => increment x = x + 1 end for all end definition
  example "|largest admitted input| : x = 126 expect increment x = 127 end example
end law

law "|dependent gap| is
  definition : for all (x :: Int8) (y :: Int8 where y > x) =>
    inverseGap x y = 1 / (y - x) end for all
  end definition
  example "|difference exceeds Int8| :
    x = -128 y = 127 expect inverseGap x y = rational(1, 255)
  end example
end law
end unit
