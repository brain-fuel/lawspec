unit example.functionParameters

-- Definitions that take a function. Each call names the function, and the
-- generated code has one plain function per function named.

function double (n :: Integer) -> Integer is n * 2 end function

function increment (n :: Integer) -> Integer is n + 1 end function

function scaled (factor :: Integer) (n :: Integer) -> Integer is factor * n end function

function isEven (n :: Integer) -> Bool is prelude.rem n 2 = 0 end function

function applyTwice (f :: a -> a) (x :: a) -> a is f (f x) end function

-- The function parameter is passed on unchanged to the recursive call.
function each (f :: a -> b) (xs :: List a) -> List b is
  first matching case of xs:
    when Nil then []
    when Cons x rest then Cons (f x) (each f rest)
  end case
end function

function keeping (keep :: a -> Bool) (xs :: List a) -> List a is
  first matching case of xs:
    when Nil then []
    when Cons x rest then if keep x then Cons x (keeping keep rest) else keeping keep rest end if
  end case
end function

-- A function parameter passed on to other definitions.
function eachTwice (f :: a -> a) (xs :: List a) -> List a is
  each f (each f xs)
end function

function evensDoubled (xs :: List Integer) -> List Integer is
  each double (keeping isEven xs)
end function

function scaledBy (factor :: Integer) (xs :: List Integer) -> List Integer is
  each (scaled factor) xs
end function

law "|a named function is applied| is
  definition :
    applyTwice double 3 = 12
    and applyTwice increment 3 = 5
    and each double [1, 2, 3] = [2, 4, 6]
    and each isEven [1, 2] = [false, true]
    and keeping isEven [1, 2, 3, 4] = [2, 4]
    and eachTwice increment [1, 2] = [3, 4]
  end definition
end law

law "|a partial application or a composition is a function| is
  definition :
    each (scaled 3) [1, 2] = [3, 6]
    and each (double . increment) [1, 2] = [4, 6]
    and scaledBy 5 [1, 2] = [5, 10]
  end definition
end law

law "|each agrees with map| is
  definition :
    for all (xs :: List Integer) =>
      each double xs = prelude.map double xs
    end for all
  end definition
end law

law "|keeping agrees with filter| is
  definition :
    for all (xs :: List Integer) =>
      keeping isEven xs = prelude.filter isEven xs
    end for all
  end definition
end law

law "|each keeps the length| is
  definition :
    for all (factor :: Integer) (xs :: List Integer) =>
      prelude.length (scaledBy factor xs) = prelude.length xs
    end for all
  end definition
end law

law "|evens doubled are even| is
  definition :
    for all (xs :: List Integer) =>
      prelude.all isEven (evensDoubled xs)
    end for all
  end definition
end law
end unit
