unit example.atoi_codec

itoa :: Int32 -> Text
atoi :: Text -> Int32

law "|itoa and then atoi yields a| is
  definition :
    apply law "|round trip identity is preserved| itoa atoi
  end definition

  description :
    "converting an Int32 to Text with {itoa} and then back with {atoi} yields the original Int32"
  end description

  rationale :
    "representing an Int32 as Text must not change its value"
  end rationale

  example "|negative integers use a minus sign and round-trip unchanged| :
    x = -42
    expect itoa x = "-42"
    expect atoi (itoa x) = -42
  end example

  example "|zero renders as 0 and round-trips unchanged| :
    x = 0
    expect itoa x = "0"
    expect atoi (itoa x) = 0
  end example

  references :
    "left inverse"
    "round-trip property"
  end references
end law
end unit
