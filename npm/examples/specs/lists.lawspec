unit example.lists

reverse :: List Int32 -> List Int32
sort :: List Int32 -> List Int32
sorted :: List Int32 -> Bool
permutation :: List Int32 -> List Int32 -> Bool
echoMaybe :: Maybe (Maybe Bool) -> Maybe (Maybe Bool)
echoEither :: Either (List Int32) (Maybe Bool) -> Either (List Int32) (Maybe Bool)
echoNested :: List (Maybe (Either CodeUnit16 Bytes)) -> List (Maybe (Either CodeUnit16 Bytes))

law "|list involution| (f :: List a -> List a) requires Eq a is
  definition : apply law "|involution| f end definition
end law

law "|reverse twice restores the list| is
  definition : apply law "|list involution| reverse end definition
  example "|ordered input| :
    x = [3, 1, 2]
    expect reverse x = [2, 1, 3]
  end example
  example "|empty input| : x = [] expect reverse x = [] end example
end law

law "|sorting is idempotent| is
  definition : apply law "|idempotent| sort end definition
  example "|duplicates| : x = [3, 1, 3] expect sort x = [1, 3, 3] end example
end law

law "|sort produces sorted output| is
  definition : for all (xs :: List Int32) => sorted (sort xs) end for all end definition
end law

law "|sort preserves length| is
  definition : for all (xs :: List Int32) => prelude.length (sort xs) = prelude.length xs end for all end definition
end law

law "|sort preserves elements| is
  definition : for all (xs :: List Int32) => permutation (sort xs) xs end for all end definition
end law

law "|nonempty reversal preserves length| is
  definition :
    for all (xs :: List Int32 where prelude.length xs > 0) =>
      prelude.length (reverse xs) = prelude.length xs end for all
  end definition
end law

law "|Maybe preserves nested absence| is
  definition : for all (x :: Maybe (Maybe Bool)) => echoMaybe x = x end for all end definition
  example "|outer absence| : x = Nothing expect echoMaybe x = Nothing end example
  example "|inner absence| : x = Just Nothing expect echoMaybe x = Just Nothing end example
  example "|present| : x = Just (Just true) expect echoMaybe x = Just (Just true) end example
end law

law "|Either preserves branches| is
  definition : for all (x :: Either (List Int32) (Maybe Bool)) => echoEither x = x end for all end definition
  example "|left list| : x = Left [3, 1, 3] expect echoEither x = Left [3, 1, 3] end example
  example "|right absence| : x = Right Nothing expect echoEither x = Right Nothing end example
end law

law "|nested raw values survive| is
  definition : for all (xs :: List (Maybe (Either CodeUnit16 Bytes))) => echoNested xs = xs end for all end definition
  example "|surrogate and octets| :
    xs = [Nothing, Just (Left codeUnit16(55296)), Just (Right bytes([0, 255]))]
    expect echoNested xs = [Nothing, Just (Left codeUnit16(55296)), Just (Right bytes([0, 255]))]
  end example
end law
end unit
