unit example.sequences

-- Text, Bytes and List are sequences: joined with ++, sliced, and read by
-- index. Bytes give their octets, and Text its UTF-8 encoding.

-- A record key's hash: FNV-1a over the key's octets, in 32 bits.
definition fnv (octets :: List UInt8) (hash :: UInt32) :: UInt32 is
  match octets with
  | Nil -> hash
  | Cons o rest -> fnv rest (prelude.wrapping ((xorByte hash o) * 16777619))
  end
end

-- hash xor o, for an octet o, by its low eight bits.
definition xorByte (hash :: UInt32) (o :: UInt8) :: Integer is
  let low = prelude.rem hash 256 in
  hash - low + xorBits low o 128
end

definition xorBits (a :: Integer) (b :: Integer) (bit :: Integer) :: Integer is
  if bit <= 0 || a < 0 || b < 0 then 0 else
    (if prelude.quot a bit != prelude.quot b bit then bit else 0)
      + xorBits (prelude.rem a bit) (prelude.rem b bit) (prelude.quot bit 2)
end

definition keyHash (key :: Bytes) :: UInt32 is fnv (prelude.octets key) 2166136261 end

definition partitionFor (key :: Bytes) (n :: Int32) :: Int32 is
  if n >= 1 then prelude.Int32 (prelude.rem (keyHash key) n) else 0
end

law `a key's partition exists` is
  definition is
    `for all` (key :: Bytes) (n :: Int32 where n >= 1 && n <= 64) .
      (partitionFor key n >= 0 && partitionFor key n < n) = true
  end
end

law `the hash follows FNV-1a` is
  definition is keyHash (prelude.utf8 "a") = 3826002220 and keyHash (prelude.utf8 "") = 2166136261 end
end

-- Member ids, made by the coordinator from a client id and a counter.
definition memberId (client :: Text) (n :: Int32) :: Text is client ++ "-" ++ prelude.textOf n end

law `a member id starts with its client` is
  definition is
    `for all` (client :: Text) (n :: Int32) . memberId client n starts with client
  end
  example `the third` is
    client = "consumer"
    n = 3
    expect memberId client n = "consumer-3"
  end
end

law `joining text adds lengths` is
  definition is
    `for all` (a :: Text) (b :: Text) . prelude.length (a ++ b) = prelude.length a + prelude.length b
  end
end

law `octets and bytes round trip` is
  definition is `for all` (b :: Bytes) . prelude.bytesOf (prelude.octets b) = b end
end

law `a slice is a part` is
  definition is
    `for all` (xs :: List Int32) (k :: Int32 where k >= 0 && k <= 10) .
      prelude.take k xs ++ prelude.drop k xs = xs
  end
end

law `at reads the item an index names` is
  definition is
    `for all` (x :: Int32) (xs :: List Int32) . prelude.at 0 (Cons x xs) = Just x and prelude.at (prelude.length xs + 1) (Cons x xs) = Nothing
  end
end

law `texts join with a separator` is
  definition is prelude.join ", " ["a", "b", "c"] = "a, b, c" and prelude.slice 1 3 "kafka" = "af" end
end

law `utf8 encodes code points` is
  definition is prelude.utf8 "é" = prelude.bytesOf [195, 169] and prelude.length (prelude.utf8 "é") = 2 end
end
