unit example.alternatives

render :: Int32 -> Text
referenceRender :: Int32 -> Text
clamp :: Int32 -> Int32
referenceClamp :: Int32 -> Int32

law "|decimal renderers agree| is
  definition :
    apply law "|equivalent| render referenceRender
  end definition
  description :
    "{render} agrees with {referenceRender} on decimal formatting"
  end description
  rationale :
    "changing the formatting implementation must preserve its result"
  end rationale
  example "|both renderers produce "-42"| :
    x = -42
    expect render x = "-42"
    expect referenceRender x = "-42"
  end example
  example "|both renderers produce "0"| :
    x = 0
    expect render x = "0"
    expect referenceRender x = "0"
  end example
end law

law "|nonnegative clamps agree| is
  definition :
    apply law "|equivalent| clamp referenceClamp
  end definition
  description :
    "{clamp} agrees with {referenceClamp} when clamping negative inputs to zero"
  end description
  example "|both clamps return 0 for -2147483648| :
    x = -2147483648
    expect clamp x = 0
    expect referenceClamp x = 0
  end example
  example "|both clamps return 2147483647 for 2147483647| :
    x = 2147483647
    expect clamp x = 2147483647
    expect referenceClamp x = 2147483647
  end example
end law
end unit
