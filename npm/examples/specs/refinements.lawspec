unit example.refinements

refinement Between (T :: Type) (minimum :: T) (maximum :: T)
  requires Ordered T is
  (value :: T where minimum <= value && value <= maximum)
end refinement

refinement Positive (T :: Type) requires Integer T is
  (value :: T where value > 0)
end refinement

refinement AdditionOverflows (T :: Type) (left :: T)
  requires Integer T Bounded T is
  (right :: T where left + right > T.max)
end refinement

add :: (x :: Int8)
    -> (y :: AdditionOverflows Int8 x)
    -> (result :: Integer where result = x + y)
successor :: (x :: Int8) -> (result :: Integer where result = x + 1)
count :: (text :: Text where prelude.length text > 0)
      -> (result :: Integer where result = prelude.length text)
preserve :: (x :: UInt64) -> (result :: Integer where result = x)
positive :: (x :: Positive Int8) -> (result :: Positive Int8 where result = x)

law "|maximum input| is
  definition : for all (x :: Int8) => successor x = x + 1 end for all end definition
  example "|beyond Int8| : x = 127 expect successor x = 128 end example
end law

law "|overflow pairs| is
  definition :
    for all (x :: Int8) (y :: AdditionOverflows Int8 x) =>
      add x y = x + y end for all
  end definition
  example "|smallest overflowing sum| : x = 127 y = 1 expect add x y = 128 end example
  example "|largest sum| : x = 127 y = 127 expect add x y = 254 end example
end law

law "|bounded input| is
  definition : for all (x :: Between Int8 1 3) => positive x = x end for all end definition
  example "|middle| : x = 2 expect positive x = 2 end example
end law

law "|large integer| is
  definition : for all (x :: UInt64) => preserve x = x end for all end definition
  example "|maximum UInt64| : x = 18446744073709551615 expect preserve x = 18446744073709551615 end example
end law

abstractEcho :: (x :: Integer) -> (result :: Integer where result = x)

law "|nested presence| is
  definition : for all (x :: Optional (Nullable (Positive Int8))) => x = x end for all end definition
end law

law "|finite positive floats| is
  definition :
    for all (x :: Float32 where prelude.isFinite x && x > 0) =>
      prelude.isFinite x end for all
  end definition
  example "|positive| : x = 0.5 expect x = 0.5 end example
end law

law "|raw byte length| is
  definition : for all (x :: Bytes where prelude.length x = 3) => prelude.length x = 3 end for all end definition
  example "|arbitrary octets| : x = bytes([0,128,255]) expect prelude.length x = 3 end example
end law

law "|guarded predicate arithmetic| is
  definition : for all (x :: Int8) (y :: Int8 where x != 0 && y > 10 / x) => y > 10 / x end for all end definition
end law

law "|machine bound| is
  definition : for all (x :: IntSize where x = IntSize.max) => x = IntSize.max end for all end definition
end law

law "|symbol fixture refinement| is
  definition :
    for all (x :: Symbol where x = symbol("selected", "fixture")) =>
      x = symbol("selected", "fixture") end for all
  end definition
  example "|selected identity| :
    x = symbol("selected", "fixture")
    expect x = symbol("selected", "fixture")
  end example
end law
end unit
