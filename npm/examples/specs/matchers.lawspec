unit example.matchers

-- Matchers are typed predicates that read like sentences. Each one is a
-- Bool, so a law may combine them with && and ||, and an example may expect
-- one to hold.

type Order is one of
  | Pending  of type Int32
  | Shipped of type record{ id :: Int32 carrier :: Text}
  | Cancelled of type record{ id :: Int32 reason :: Maybe Text}
end type

-- Native adapters, written on each target.
sortItems :: List Int32 -> List Int32
uniqueTags :: List Text -> List Text
average :: Int32 -> Int32 -> Float64
slug :: Text -> Text
ship :: Int32 -> Order

law "|sorting keeps every item| is
  definition :
    for all (xs :: List Int32) => sortItems xs has same items as xs end for all
  end definition
  example "|duplicates stay| :
    xs = [3, 1, 3]
    expect sortItems xs = [1, 3, 3]
  end example
end law

law "|unique tags come from the input| is
  definition :
    for all (tags :: List Text) =>
      uniqueTags tags is subset of tags && tags contains all of uniqueTags tags end for all
  end definition
end law

law "|unique tags keep each tag| is
  definition :
    for all (tags :: List Text) (tag :: Text) =>
      tags contains tag implies uniqueTags tags contains tag end for all
  end definition
end law

law "|the average lies between the two| is
  definition :
    for all (a :: Int32) (b :: Int32) =>
      average a b is within 0.5 of prelude.Float64 (prelude.quot (a + b) 2) end for all
  end definition
end law

law "|a slug is lowercase words joined by dashes| is
  definition :
    for all (title :: Text) =>
      slug title matches regex "([a-z0-9]+(-[a-z0-9]+)*)?" end for all
  end definition
  example "|a title| :
    title = "Hello World"
    expect slug title = "hello-world"
    expect slug title starts with "hello"
    expect slug title ends with "world"
    expect slug title contains "o-w"
  end example
end law

law "|shipping gives a shipped order| is
  definition :
    for all (id :: Int32) => ship id matches Shipped record{ id = _ , carrier = _} end for all
  end definition
  example "|the carrier is never empty| :
    id = 7
    expect ship id matches Shipped record{ id = 7 , carrier = _}
    expect !(ship id matches Shipped record{ id = _ , carrier = ""})
  end example
end law

-- Laws of the matchers themselves.
law "|having the same items is symmetric| is
  definition :
    for all (xs :: List Int8) (ys :: List Int8) =>
      (xs has same items as ys) = (ys has same items as xs) end for all
  end definition
end law

law "|a list contains each of its items| is
  definition :
    for all (x :: Int8) (xs :: List Int8) => Cons x xs contains x end for all
  end definition
end law

law "|a list is a subset of itself| is
  definition :
    for all (xs :: List Int8) => xs is subset of xs && xs contains all of xs end for all
  end definition
end law

law "|a text starts and ends with itself| is
  definition :
    for all (t :: Text) => t starts with t && t ends with t && t contains t && t contains "" end for all
  end definition
end law

law "|a number is within any tolerance of itself| is
  definition :
    for all (x :: Int32) (d :: Int32 where d >= 0) => x is within d of x end for all
  end definition
end law

law "|a regex value matches like a literal| is
  definition :
    for all (t :: Text) => (t matches regex "[a-c]*") = (t matches regex "[a-c]*") end for all
  end definition
end law
end unit
