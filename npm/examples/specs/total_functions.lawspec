unit example.total_functions

-- These functions are implemented in the specification. LawSpec checks their
-- bodies and emits reusable source; they do not need adapter implementations.
function increment (x :: a) -> Integer
requires Integer a
is
  x + 1
end function

function count (xs :: List a) -> Integer is
  first matching case of xs :
    when Nil then 0
    when Cons head tail then 1 + count tail
  end case
end function

function nonempty (xs :: List a) -> Bool is
  first matching case of xs :
    when Nil then false
    when Cons head tail then true
  end case
end function

law "|nonempty lists have positive length| is
  definition :
    for all (xs :: List Int8 where nonempty xs) => count xs > 0 end for all
  end definition
  example "|singleton| : xs = [0] expect count xs = 1 end example
end law

-- The exact guard proves that the promoted denominator cannot be zero.
function positiveReciprocal (x :: a) -> Bool
requires Integer a
is
  x >= 0 && 1 / (x + 1) > 0
end function

law "|guarded exact arithmetic| is
  definition :
    for all (x :: Int8) => positiveReciprocal x = (x >= 0) end for all
  end definition
  example "|skip zero denominator| :
    x = -1 expect positiveReciprocal x = false
  end example
  example "|promote before division| :
    x = 127 expect positiveReciprocal x = true
  end example
end law

function guardedNarrow (x :: Int8) -> Bool is
  x < 127 && prelude.Int8 (x + 1) > x
end function

law "|narrow only after proving the range| is
  definition :
    for all (x :: Int8) => guardedNarrow x = (x < 127) end for all
  end definition
  example "|largest valid conversion| : x = 126 expect guardedNarrow x = true end example
  example "|overflow branch is skipped| : x = 127 expect guardedNarrow x = false end example
end law

function same (xs :: List a) (ys :: List a) -> Bool
requires Eq a
is
  xs = ys
end function

-- The same checked template produces independent concrete instances.
law "|count also accepts text| is
  definition :
    for all (xs :: List Text) => count xs = prelude.length xs end for all
  end definition
  example "|two words| : xs = ["hello", "world"] expect count xs = 2 end example
end law

law "|increment preserves the mathematical result| is
  definition :
    for all (x :: Int8) => increment x = x + 1 end for all
  end definition
  example "|maximum input| :
    x = 127 expect increment x = 128
  end example
end law

law "|recursive count agrees with length| is
  definition :
    for all (xs :: List Int8) => count xs = prelude.length xs end for all
  end definition
  example "|empty| : xs = [] expect count xs = 0 end example
  example "|duplicates still count| : xs = [7, 7, 7] expect count xs = 3 end example
end law

law "|list equality preserves duplicates and order| is
  definition :
    for all (xs :: List Int8) (ys :: List Int8) => same xs ys = (xs = ys) end for all
  end definition
  example "|different order| :
    xs = [1, 2] ys = [2, 1] expect same xs ys = false
  end example
end law
end unit
