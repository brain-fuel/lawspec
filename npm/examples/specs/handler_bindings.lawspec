unit example.till

-- An ability whose production handler is application code, named in
-- lawspec.edn under handlers. Money is bound to a native type there too, so
-- the handler's operations take and give that type.

type Money is a record{  cents :: Int64} end type
type PayError is one of | Declined | Rejected of type record{ message :: Text} end type

-- A till's drawer. Every handler of it gives back what it takes.
ability Drawer is
  take :: Money -> Money
  opening :: Money
laws
  law "|a till gives back what it takes| is
    definition :
      for all (cents :: Int64 where cents >= 0 && cents <= 1000) => take (Money record{ cents = cents}) = Money record{ cents = cents} end for all
    end definition
  end law
end laws
end ability

handler fakeDrawer for Drawer is
  operation take money is money end operation
  operation opening is Money record{ cents = 0} end operation
end handler

-- A native adapter that fails. Its native code raises the application's own
-- exceptions; lawspec.edn maps them to PayError's constructors.
pay :: Int64 -> Money uses Drawer fails with PayError

law "|small payments go through| is
  definition :
    for all (cents :: Int64 where cents >= 0 && cents <= 1000) =>
      prelude.attempt (pay cents) = Right (Money record{ cents = cents}) end for all
  end definition
end law

law "|large payments are declined| is
  definition :
    for all (cents :: Int64 where cents > 1000 && cents <= 100000) =>
      prelude.attempt (pay cents) = Left Declined end for all
  end definition
end law

law "|negative payments are rejected| is
  definition :
    for all (cents :: Int64 where cents >= -1000 && cents < 0) =>
      prelude.attempt (pay cents) = Left (Rejected record{ message = "negative"}) end for all
  end definition
end law

-- The same failures, as a law expects them: `fails with` matches the
-- constructor a mapped exception became, and its message.
law "|large payments fail as declined| is
  definition :
    for all (cents :: Int64 where cents > 1000 && cents <= 100000) => pay cents fails with Declined end for all
  end definition
end law

law "|negative payments say why they are rejected| is
  definition :
    for all (cents :: Int64 where cents >= -1000 && cents < 0) =>
      pay cents fails with Rejected record{ message = _} message contains "negative" end for all
  end definition
end law
end unit
