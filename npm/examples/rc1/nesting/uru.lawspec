unit example.delivery.uru

type File is one of
  | Pdf of type record{fileName of type Text
    byteCount of type Whole}
  | PlainText of type record{fileName of type Text}
end type

type Delivery is one of
  | Email of type record{recipient of type Text
    document of type record{number of type Text
      file of type File}}
  | Download of type record{document of type record{number of type Text
      file of type File}}
end type

function "|email invoice PDF file name|
  (delivery of type Delivery) -> Maybe Text is
  first matching case of delivery:
    when Email record{document = record{file = Pdf record{fileName = name}}}
      then Just name
    otherwise Nothing
  end case
end function

function emailPdfInvoice (name of type Text) -> Delivery is
  Email (record{recipient = "accounts@example.com", document =
    record{number = "INV-2026-10", file = (Pdf (record{fileName
        = name, byteCount = 1200}))}})
end function

law "|emailPdfInvoice result| is
  description:
    "PDF invoices sent by email retain their file names."
  end description
  definition:
    "|email invoice PDF file name| (emailPdfInvoice "invoice.pdf") must be Just
    "invoice.pdf"
  end definition
end law

function emailPlainTextInvoice (name of type Text) -> Delivery is
  Email (record{recipient = "accounts@example.com", document =
    record{number = "INV-2026-10", file = (PlainText (record{fileName =
        name}))}})
end function

law "|emailPlainTextInvoice result| is
  description:
    "Plain-text invoices have no PDF file name."
  end description
  definition:
    "|email invoice PDF file name| (emailPlainTextInvoice "invoice.pdf") must be
    Nothing
  end definition
end law

function downloadPdfInvoice (name of type Text) -> Delivery is
  Download (record{document = record{number =
      "INV-2026-10", file = (Pdf (record{fileName = name, byteCount =
        1200}))}})
end function

law "|downloadPdfInvoice result| is
  description:
    "Downloads have no email invoice PDF file name."
  end description
  definition:
    "|email invoice PDF file name| (downloadPdfInvoice "invoice.pdf") must be
    Nothing
  end definition
end law
end unit
