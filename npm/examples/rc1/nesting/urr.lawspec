unit example.delivery.urr

type PdfFile is a record{
  fileName of type Text
  byteCount of type Whole
}
end type

type Invoice is a record{
  number of type Text
  file of type PdfFile
}
end type

type EmailDetails is a record{
  recipient of type Text
  document of type Invoice
}
end type

type DownloadDetails is a record{
  document of type Invoice
}
end type

type Delivery is one of
  | Email of type EmailDetails
  | Download of type DownloadDetails
end type

function "|email invoice PDF file name|
  (delivery of type Delivery) -> Maybe Text is
  first matching case of delivery:
    when Email record{document = record{file = record{fileName = name}}}
      then Just name
    otherwise Nothing
  end case
end function

function emailPdfInvoice (name of type Text) -> Delivery is
  Email (EmailDetails record{recipient = "accounts@example.com", document =
    Invoice record{number = "INV-2026-10", file = PdfFile record{fileName =
        name,
        byteCount = 1200}}})
end function

law "|emailPdfInvoice result| is
  description:
    "PDF invoices sent by email retain their file names."
  end
  definition:
    "|email invoice PDF file name| (emailPdfInvoice "invoice.pdf") must be Just
    "invoice.pdf"
  end
end

function downloadPdfInvoice (name of type Text) -> Delivery is
  Download (DownloadDetails record{document = Invoice record{number =
      "INV-2026-10", file = PdfFile record{fileName = name, byteCount = 1200}}})
end function

law "|downloadPdfInvoice result| is
  description:
    "Downloads have no email invoice PDF file name."
  end
  definition:
    "|email invoice PDF file name| (downloadPdfInvoice "invoice.pdf") must be
    Nothing
  end
end
