unit example.rc1.requirementComposition

import example.rc1.authorizationSnapshots as snapshot
  (Payment, Authorization, AuthorizationState, active, authorizes)

law "|each item has a match| (relation of type a -> b -> Bool) is
  definition:
    for all (item of type b) =>
      there exists (witness of type a) such that
        relation witness item
      end exists
    end for all
  end definition
end law

function revokedMatch (authorization of type Authorization)
  (payment of type Payment) -> Bool is
  active AllRevoked authorization and authorizes authorization payment
end function

law "|matching and readiness agree| is
  definition:
    (apply law "|each item has a match| authorizes)
    and
    (for all (payment of type Payment) =>
      there exists (authorization of type Authorization
        where active Ready authorization) such that
        authorizes authorization payment
      end exists
    end for all)
  end definition

  description:
    "Every payment has a matching identity and an active approval when ready."
  end description
end law

law "|revocation or matching has a complete explanation| is
  definition:
    (must not apply law "|each item has a match| revokedMatch)
    or apply law "|each item has a match| authorizes
  end definition

  description:
    "Either revoked approvals cannot cover every payment, or matching succeeds."
  end description
end law

law "|matching implies ready approval coverage| is
  definition:
    (apply law "|each item has a match| authorizes)
    implies
    (for all (payment of type Payment) =>
      there exists (authorization of type Authorization
        where active Ready authorization) such that
        authorizes authorization payment
      end exists
    end for all)
  end definition
end law

law "|payment and approval identities have separate scopes| is
  definition:
    (for all (value of type Payment) =>
      value = FirstPayment or value = SecondPayment
    end for all)
    and
    (for all (value of type Authorization) =>
      value = FirstApproval or value = SecondApproval
    end for all)
  end definition
end law

law "|an empty condition does not hide required coverage| is
  definition:
    (for all (authorization of type Authorization where false) =>
      false
    end for all)
    and
    (there exists (authorization of type Authorization
      where active Ready authorization) such that
      authorizes authorization FirstPayment
    end exists)
  end definition

  rationale:
    "A vacuous first clause leaves the approval requirement in force."
  end rationale
end law
end unit
