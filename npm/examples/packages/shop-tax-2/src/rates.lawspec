unit shop.tax.rates

-- Version 2 adds a zero band and changes the rates. A build may hold both
-- versions: each dependent sees the one its version range selects.
type Band is one of | Zero | Low | High end type

function rateOf (b :: Band) -> Int64 is
  first matching case of b : when Zero then 0 when Low then 10 when High then 25
  end case
end function
