{
  :manifest-version 1
  :component {
    :name "clojure"
    :version "0.1.0"
  }
  :sources ["laws"]
  :machine-bits 64
  :targets [
    {
      :language :clojure
      :root "."
      :native-bindings {
        :functions [
          {
            :declaration "example.payments::addFee"
            :native ["domain" "payments" "apply_fee"]
          }
          {
            :declaration "example.payments::roundTrip"
            :native ["domain" "payments" "restore"]
          }
          {
            :declaration "example.payments::archive"
            :native ["domain" "payments" "store"]
          }
        ]
        :generators [
          {
            :type "example.payments::type::Money"
            :factory ["domain" "payment_generators" "prices"]
          }
        ]
      }
    }
  ]
  :language-profile "1.0-rc.2"
  :verification {
    :layers [
      :proof
      :exhaustive
      :property
      :examples
      :runtime
      :model
    ]
  }
}
