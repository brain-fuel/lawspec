{
  :manifest-version 1
  :component {
    :name "rust"
    :version "0.1.0"
  }
  :sources ["laws"]
  :machine-bits 64
  :targets [
    {
      :language :rust
      :root "."
      :native-bindings {
        :rust-crate "lawspec_example"
        :types [
          {
            :type "example.payments::type::Currency"
            :native ["crate" "domain" "CurrencyCode"]
            :constructors [
              {
                :constructor "USD"
                :native ["crate" "domain" "CurrencyCode" "Dollars"]
                :style "unit"
                :fields []
              }
              {
                :constructor "EUR"
                :native ["crate" "domain" "CurrencyCode" "Euros"]
                :style "unit"
                :fields []
              }
              {
                :constructor "GBP"
                :native ["crate" "domain" "CurrencyCode" "Pounds"]
                :style "unit"
                :fields []
              }
            ]
          }
          {
            :type "example.payments::type::Money"
            :native ["crate" "domain" "Price"]
            :constructors [
              {
                :constructor "Money"
                :native ["crate" "domain" "Price"]
                :style "record"
                :fields [
                  {
                    :field "amount"
                    :native "major"
                  }
                  {
                    :field "currency"
                    :native "unit"
                  }
                ]
              }
            ]
          }
          {
            :type "example.payments::type::Payment"
            :native ["crate" "domain" "PaymentStatus"]
            :constructors [
              {
                :constructor "Paid"
                :native ["crate" "domain" "PaymentStatus" "Settled"]
                :style "variant"
                :fields [
                  {
                    :field "value"
                    :native "price"
                  }
                ]
              }
              {
                :constructor "Declined"
                :native ["crate" "domain" "PaymentStatus" "Rejected"]
                :style "variant"
                :fields [
                  {
                    :field "value"
                    :native "explanation"
                  }
                ]
              }
            ]
          }
        ]
        :functions [
          {
            :declaration "example.payments::addFee"
            :native ["crate" "domain" "apply_fee"]
          }
          {
            :declaration "example.payments::roundTrip"
            :native ["crate" "domain" "restore"]
          }
          {
            :declaration "example.payments::archive"
            :native ["crate" "domain" "store"]
          }
        ]
        :generators [
          {
            :type "example.payments::type::Money"
            :factory ["lawspec_generators" "prices"]
          }
        ]
      }
    }
  ]
  :language-profile "1.0-rc.2"
  :verification {
    :layers [
      :proof
      :exhaustive
      :property
      :examples
      :runtime
      :model
    ]
  }
}
