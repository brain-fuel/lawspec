unit example.nested_refinements

-- A list that must hold something, as a wrapper over any element type.
wrapper NonEmptyList (a :: Type) is List a where prelude.length value > 0
end wrapper

wrapper Label is Text where prelude.length value > 0 end wrapper

type Choice is a record{
  id :: Label
  summary :: Label
}
end type

type Assignment is a record{
  who :: Label
  what :: Label
  due :: Maybe Integer
}
end type

type Check is a record{
  expected :: Label
  observed :: Label
  worked :: Bool
}
end type

-- The restricted lists sit three records below the sum a law draws.
type Decision is a record{
  diagnosis :: Label
  choices :: NonEmptyList Choice
  chosen :: Label
  assignments :: NonEmptyList Assignment
  review :: Maybe Check
}
end type

type TimeBudget is a record{
  minutes :: Integer
  basis :: Label
}
end type

type TimedDecision is a record{
  time :: TimeBudget
  decision :: Decision
}
end type

type Method is one of
  | Noted of type Label
  | Decided of type Decision
  | DecidedInTime of type TimedDecision
end type

function assigned (decision :: Decision) -> Integer is
  prelude.length (valueOfNonEmptyList decision.assignments)
end function

function workload (method :: Method) -> Integer is
  first matching case of method:
    when Noted label then 0
    when Decided decision then assigned decision
    when DecidedInTime timed then assigned timed.decision
  end case
end function

function isNote (method :: Method) -> Bool is
  first matching case of method:
    when Noted label then true
    when Decided decision then false
    when DecidedInTime timed then false
  end case
end function

law "|a decision in time assigns someone| is
  definition:
    for all (timed :: TimedDecision) =>
      assigned timed.decision >= 1
    end for all
  end definition
end law

law "|only a note has no workload| is
  definition:
    for all (method :: Method) =>
      (workload method = 0) = isNote method
    end for all
  end definition
end law

-- A wide record whose restricted list sits under two sums and a Maybe, in a
-- law that writes no value of that list: nothing seeds it but the generator.
-- At the node budget of 64 the record's eleven fields leave `pattern` five
-- nodes and `earlier` four, so the list under OnWeekdays is planned at two
-- nodes, the size of the empty list its wrapper refuses.
type Weekday is one of
  | Monday
  | Tuesday
  | Wednesday
  | Thursday
  | Friday
  | Saturday
  | Sunday
end type

type Period is one of
  | PerDay
  | PerWeek
  | PerMonth
end type

type Frequency is one of
  | EveryN of type record{ count :: Integer period :: Period}
  | OnWeekdays of type NonEmptyList Weekday
  | Described of type Label
end type

type Pattern is one of
  | Once of type Maybe Integer
  | Recurring of type Maybe Frequency
  | AsNeeded of type Maybe Frequency
end type

type Start is one of
  | Manual
  | Immediate
  | Cued of type Label
end type

type Recognition is a record{
  choice :: Label
  recipient :: Maybe Label
  occasion :: Maybe Label
  details :: Maybe Label
}
end type

type Practice is a record{
  id :: Label
  owner :: Label
  action :: Label
  pattern :: Pattern
  fallback :: Maybe Pattern
  earlier :: List Frequency
  start :: Start
  recognition :: Recognition
  obstacle :: Label
  review :: Check
  chosen :: Choice
}
end type

function isOnce (pattern :: Pattern) -> Bool is
  first matching case of pattern:
    when Once date then true
    when Recurring frequency then false
    when AsNeeded frequency then false
  end case
end function

function repeats (practice :: Practice) -> Bool is
  first matching case of practice.pattern:
    when Once date then false
    when Recurring frequency then true
    when AsNeeded frequency then true
  end case
end function

law "|a practice repeats unless it is done once| is
  definition:
    for all (practice :: Practice where
      practice.start = Manual or practice.start = Immediate) =>
      not (repeats practice = isOnce practice.pattern)
    end for all
  end definition
end law
end unit
