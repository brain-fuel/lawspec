unit native.shapes

type Box (a :: Type) is a record{  item :: a} end type
type Chain (a :: Type) is one of
  Stop
  More of type record{ value :: a tail :: Maybe (Chain a)}
end type
type Tree (a :: Type) is one of
  Leaf  of type a
  Branch  of type List (Tree a)
end type
type Stamp is one of Stamp end type

copyBox :: Box Int8 -> Box Int8
copyChain :: Chain Int8 -> Chain Int8
copyTree :: Tree Text -> Tree Text
copyNested :: Box (Maybe (Box Int8)) -> Box (Maybe (Box Int8))
copyStamp :: Stamp -> Stamp

law "|generic box| is
  definition : for all (x :: Box Int8) => copyBox x = x end for all end definition
  example "|maximum| : x = Box record{ item = 127} expect copyBox x = Box record{ item = 127} end example
end law
law "|inline recursive chain| is
  definition : for all (x :: Chain Int8) => copyChain x = x end for all end definition
  example "|nested| :
    x = More record{ value = 7 , tail = (Present (More record{ value = -128 , tail = Absent}))}
    expect copyChain x = More record{ value = 7 , tail = (Present (More record{ value = -128 , tail = Absent}))}
  end example
end law
law "|recursion through a list| is
  definition : for all (x :: Tree Text) => copyTree x = x end for all end definition
  example "|branches| :
    x = Branch [Leaf "λ", Branch []]
    expect copyTree x = Branch [Leaf "λ", Branch []]
  end example
end law
law "|nested instantiations| is
  definition : for all (x :: Box (Maybe (Box Int8))) => copyNested x = x end for all end definition
  example "|present| : x = Box record{ item = (Present (Box record{ item = 42}))} expect copyNested x = Box record{ item = (Present (Box record{ item = 42}))} end example
  example "|absent| : x = Box record{ item = Absent} expect copyNested x = Box record{ item = Absent} end example
end law
law "|empty record| is
  definition : for all (x :: Stamp) => copyStamp x = x end for all end definition
  example "|one value| : x = Stamp expect copyStamp x = Stamp end example
end law

law "|refinements retain the selected generator| is
  definition : for all (x :: Int8 where x > 5) => x = x end for all end definition
end law
end unit
