unit pictures.tuples

type Orientation is one of
  | Landscape
  | Portrait
  | Square
end type

type Picture is a record{
  fileName of type Text
  dimensions of type (Nat, Nat)
}
end type

function orientation
  (record{dimensions = (width, height)} of type Picture) -> Orientation is
  first matching case of width:
    when it > height then Landscape
    when it < height then Portrait
    otherwise Square
  end case
end function

law "|tuple dimensions determine orientation| is
  description:
    "Width comes first and height second in a picture's dimensions."
  end description
  definition:
    for all (picture of type Picture) =>
      orientation picture must be
      first matching case of picture.dimensions:
        when (width, height) then
          if width > height then Landscape
          else if width < height then Portrait
            else Square
            end if
          end if
      end case
    end for all
  end definition
  expect orientation picture = expected
  in table (picture, expected):
    row Picture record{fileName = "wide.jpg", dimensions = (12, 8)}, Landscape
    row Picture record{fileName = "tall.jpg", dimensions = (8, 12)}, Portrait
    row Picture record{fileName = "square.jpg", dimensions = (10, 10)}, Square
  end table
end law
end unit
