unit external.binding

type Box (a :: Type) is a record{  value :: a} end type
type Tree (a :: Type) is one of Leaf  of type a Branch  of type List (Tree a) end type
type Currency is one of USD | EUR end type
copyBox :: Box Int8 -> Box Int8
copyTree :: Tree Text -> Tree Text
copyNested :: Box (List (Box Int8)) -> Box (List (Box Int8))
copyCurrency :: Currency -> Currency
law "|external generic product| is
  definition : for all (x :: Box Int8) => copyBox x = x end for all end definition
  example "|maximum| : x = Box record{ value = 127} expect copyBox x = Box record{ value = 127} end example
end law
law "|external recursive sum| is
  definition : for all (x :: Tree Text) => copyTree x = x end for all end definition
  example "|nested| : x = Branch [Leaf "λ", Branch []] expect copyTree x = Branch [Leaf "λ", Branch []] end example
end law
law "|external nested instances| is
  definition : for all (x :: Box (List (Box Int8))) => copyNested x = x end for all end definition
end law
law "|external enum| is
  definition : for all (x :: Currency) => copyCurrency x = x end for all end definition
end law

copyWide :: Box UInt64 -> Box UInt64
law "|external unsigned precision| is
  definition : for all (x :: Box UInt64) => copyWide x = x end for all end definition
  example "|unsigned maximum| : x = Box record{ value = 18446744073709551615} expect copyWide x = Box record{ value = 18446744073709551615} end example
end law
end unit
