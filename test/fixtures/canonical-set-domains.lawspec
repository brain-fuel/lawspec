unit example.set_domains

type Empty is one of
end type

law "|Boolean sets contain at most two members| is
  definition:
    for all (members of type Set Bool) =>
      prelude.size members <= 2
    end for all
  end definition
  expect prelude.toList members = expected
  in table (members, expected):
    row #S{}, []
    row #S{false}, [false]
    row #S{true}, [true]
    row #S{false, true}, [false, true]
    row #S{true, false}, [true, false]
  end table
end law

law "|both iteration orders are available| is
  definition:
    there exists (members of type Set Bool) such that
      prelude.toList members = [true, false]
    end exists
  end definition
end law

law "|union agrees on members in either order| is
  definition:
    for all (left of type Set Bool) (right of type Set Bool) =>
      prelude.union left right = prelude.union right left
    end for all
  end definition
end law

law "|dependent set domains retain their restrictions| is
  definition:
    for all (left of type Set Bool)
      (right of type Set Bool where prelude.size right <= prelude.size left) =>
      prelude.size right <= prelude.size left
    end for all
  end definition
end law

law "|nested Boolean sets contain at most four membership classes| is
  definition:
    for all (members of type Set (Set Bool)) =>
      prelude.size members <= 4
    end for all
  end definition
end law

law "|an empty element domain admits only an empty set| is
  definition:
    for all (members of type Set Empty) => prelude.size members = 0 end for all
  end definition
end law

law "|unit sets contain at most one member| is
  definition:
    for all (members of type Set ()) => prelude.size members <= 1 end for all
  end definition
end law

law "|optional Boolean sets contain at most three members| is
  definition:
    for all (members of type Set (Maybe Bool)) => prelude.size members <= 3 end for all
  end definition
end law
end unit
