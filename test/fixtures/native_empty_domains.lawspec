unit example.empty

type Empty is one of end type

type Phantom (a :: Type) is a record{
   value :: Int8}
end type

law "|phantom empty argument| is
  definition : for all (x :: Phantom Empty) => x = x end for all end definition
  example "|explicit value| : x = Phantom record{ value = 6} expect x = Phantom record{ value = 6} end example
end law

law "|list of empty| is
  definition : for all (xs :: List Empty) => xs = xs end for all end definition
end law
end unit
