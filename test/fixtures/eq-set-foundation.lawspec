-- Equality and first-occurrence iteration through the public Set interface.
unit example.eqSetFoundation

type Envelope is a record{  items :: Maybe (Set Float64)} end type

function arrangement (reverse :: Bool) -> Set Float64 is
  if reverse then prelude.setOf [float64Bits("3ff0000000000000"), float64Bits("4000000000000000")] else prelude.setOf [float64Bits("4000000000000000"), float64Bits("3ff0000000000000")] end if
end function

function sameSet (left :: Set Float64) (right :: Set Float64) -> Bool is
  left = right
end function

function stored (set :: Set Float64) -> List Float64 is
  prelude.toList set
end function

function incomplete (reverse :: Bool) -> Set Float64 is
  if reverse then prelude.setOf [float64Bits("3ff0000000000000")] else prelude.setOf [float64Bits("4000000000000000")] end if
end function

function otherMembers (reverse :: Bool) -> Set Float64 is
  if reverse then prelude.setOf [float64Bits("3ff0000000000000"), float64Bits("4008000000000000")] else prelude.setOf [float64Bits("4008000000000000"), float64Bits("3ff0000000000000")] end if
end function

function empty (reverse :: Bool) -> Set Float64 is
  if reverse then prelude.setOf [] else prelude.setOf [] end if
end function

function withNan (reverse :: Bool) -> Set Float64 is
  if reverse then prelude.setOf [float64Bits("7ff8000000000001"), float64Bits("3ff0000000000000")]
  else prelude.setOf [float64Bits("3ff0000000000000"), float64Bits("7ff8000000000001")] end if
end function

function repeatedNan (reverse :: Bool) -> Set Float64 is
  if reverse then prelude.setOf [float64Bits("7ff8000000000001"), float64Bits("7ff8000000000001")]
  else prelude.setOf [float64Bits("7ff8000000000001"), float64Bits("7ff8000000000002")] end if
end function

function singletonZero (negative :: Bool) -> Set Float64 is
  if negative then prelude.setOf [float64Bits("8000000000000000")]
  else prelude.setOf [float64Bits("0000000000000000")] end if
end function

function nested (reverse :: Bool) -> Set (Set Float64) is
  if reverse then prelude.setOf [arrangement true, incomplete true]
  else prelude.setOf [incomplete true, arrangement false] end if
end function

law "|set equality ignores iteration order| is
  definition : for all (reverse :: Bool) =>
    sameSet (arrangement reverse) (arrangement (!reverse)) = true end for all end definition
end law

law "|iteration retains construction order| is
  definition : for all (reverse :: Bool) =>
    stored (arrangement reverse) = (if reverse then [float64Bits("3ff0000000000000"), float64Bits("4000000000000000")] else [float64Bits("4000000000000000"), float64Bits("3ff0000000000000")] end if) end for all end definition
end law

law "|set equality detects missing members| is
  definition : for all (reverse :: Bool) =>
    sameSet (arrangement reverse) (incomplete reverse) = false end for all end definition
end law

law "|set equality detects different members| is
  definition : for all (reverse :: Bool) =>
    sameSet (arrangement reverse) (otherMembers reverse) = false end for all end definition
end law

law "|empty sets compare equal| is
  definition : for all (reverse :: Bool) =>
    sameSet (empty reverse) (empty (!reverse)) = true end for all end definition
end law

law "|a nonempty set differs from empty| is
  definition : for all (reverse :: Bool) =>
    sameSet (arrangement reverse) (empty reverse) = false end for all end definition
end law

law "|set equality recurses through nominal products and alternatives| is
  definition : for all (reverse :: Bool) =>
    Envelope record{ items = (Just (arrangement reverse))} = Envelope record{ items = (Just (arrangement (!reverse)))} end for all end definition
end law

law "|set equality recurses through lists| is
  definition : for all (reverse :: Bool) =>
    [arrangement reverse] = [arrangement (!reverse)] end for all end definition
end law

law "|sets can contain Eq-only sets| is
  definition : for all (reverse :: Bool) =>
    nested reverse = nested (!reverse) end for all end definition
end law

law "|NaN membership does not use identity shortcuts| is
  definition : for all (reverse :: Bool) =>
    sameSet (withNan reverse) (withNan reverse) = false end for all end definition
end law

law "|repeated NaNs are not equal duplicates| is
  definition : for all (reverse :: Bool) =>
    sameSet (repeatedNan reverse) (repeatedNan reverse) = false end for all end definition
end law

law "|signed zeros are equal members| is
  definition : for all (reverse :: Bool) =>
    sameSet (singletonZero reverse) (singletonZero (!reverse)) = true end for all end definition
end law

law "|ordinary lists retain ordered equality| is
  definition : for all (reverse :: Bool) =>
    (stored (arrangement reverse) = stored (arrangement (!reverse))) = false end for all end definition
end law

end unit
