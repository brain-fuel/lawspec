unit authoring.batchedReadings

type Batch (a of type Type) is one of
  | Batch of type List record{value of type a}
end type

type Stored (a of type Type) is a record{
  items of type List record{value of type a}
  optional of type Maybe record{value of type a}
}
end type

type Chain (a of type Type) is one of
  | Stop
  | Link of type record{item of type a next of type Chain a}
end type

type Archive (a of type Type) is one of
  | Archive of type Chain record{value of type a}
end type

function pack (items of type List record{value of type a}) -> Batch a is
  Batch items
end function

function unpack (batch of type Batch a) -> List record{value of type a} is
  first matching case of batch:
    when Batch items then items
  end case
end function

function first (batch of type Batch a) -> Maybe a is
  first matching case of batch:
    when Batch Nil then Nothing
    when Batch (Cons record{value = value} remaining) then Just value
  end case
end function

function items (stored of type Stored a) -> List record{value of type a} is
  stored.items
end function

function optional (stored of type Stored a) -> Maybe record{value of type a} is
  stored.optional
end function

function restore (archive of type Archive a) -> Chain record{value of type a} is
  first matching case of archive:
    when Archive entries then entries
  end case
end function

law "|batches preserve both readings| is
  definition:
    for all (enabled of type Bool) =>
      unpack (pack [record{value = enabled}, record{value = not enabled}])
        must be [record{value = enabled}, record{value = not enabled}]
    end for all
  end definition
end law

law "|the first reading is selected| is
  definition:
    for all (enabled of type Bool) =>
      first (Batch [record{value = enabled}]) must be Just enabled
    end for all
  end definition

end law

law "|batch examples preserve their readings| is
  definition:
    for all (batch of type Batch Bool) =>
      unpack (pack (unpack batch)) must be unpack batch
    end for all
  end definition

  expect first batch = expected
  in table (batch, expected):
    row Batch [], Nothing
    row Batch [record{value = true}], Just true
    row Batch [record{value = false}, record{value = true}], Just false
  end table
end law

law "|stored readings remain available| is
  definition:
    for all (enabled of type Bool) =>
      items (Stored record{items = [record{value = enabled}], optional = Nothing})
        must be [record{value = enabled}]
    end for all
  end definition
end law

law "|optional readings retain their values| is
  definition:
    for all (enabled of type Bool) =>
      optional (Stored record{items = [], optional = Just record{value = enabled}})
        must be Just record{value = enabled}
    end for all
  end definition

end law

law "|stored examples retain both fields| is
  definition:
    for all (stored of type Stored Bool) =>
      Stored record{items = items stored, optional = optional stored}
        must be stored
    end for all
  end definition

  expect optional stored = expected
  in table (stored, expected):
    row Stored record{items = [], optional = Nothing}, Nothing
    row Stored record{items = [], optional = Just record{value = true}}, Just record{value = true}
  end table
end law

law "|archives preserve recursive readings| is
  definition:
    for all (enabled of type Bool) =>
      restore (Archive (Link record{item = record{value = enabled}, next = Stop}))
        must be Link record{item = record{value = enabled}, next = Stop}
    end for all
  end definition
end law
end unit
