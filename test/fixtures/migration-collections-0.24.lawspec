unit ordered

definition items (values :: Set Integer) :: List Integer is
  prelude.toList values
end

definition includes (value :: Integer) (values :: Set Integer) :: Bool is
  prelude.member value values
end

definition make (values :: List Integer) :: Set Integer is
  prelude.setOf values
end

law `ordered operations` is
  definition is
    items (make [3, 1, 3, 2]) = [1, 2, 3] and
    items (make []) = [] and items (make [2, 2]) = [2] and
    items (prelude.insert 0 (make [3, 1, 2])) = [0, 1, 2, 3] and
    items (prelude.remove 2 (make [3, 1, 2])) = [1, 3] and
    items (prelude.union (make [3, 1]) (make [2, 1])) = [1, 2, 3] and
    items (prelude.intersection (make [3, 1]) (make [2, 1])) = [1] and
    items (prelude.difference (make [3, 1]) (make [2, 1])) = [3]
  end
end

law `membership` is
  definition is
    includes 1 (make [3, 1]) = true and
    includes 2 (make [3, 1]) = false
  end
end
