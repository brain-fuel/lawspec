-- Internal checked operations; canonical exports and notation remain separate.
unit example.eq_sets
import example.eqSetAlgorithms as sets

function arrivals (reverse :: Bool) -> List Float64 is
  if reverse then [float64Bits("4000000000000000"), float64Bits("3ff0000000000000"), float64Bits("4000000000000000")]
  else [float64Bits("3ff0000000000000"), float64Bits("4000000000000000"), float64Bits("3ff0000000000000")] end if
end function

function expectedOrder (reverse :: Bool) -> List Float64 is
  if reverse then [float64Bits("4000000000000000"), float64Bits("3ff0000000000000")]
  else [float64Bits("3ff0000000000000"), float64Bits("4000000000000000")] end if
end function

function emptyFloatSet (unused :: Bool) -> Set Float64 is sets.eqSetOf [] end function

function preservedZero (negativeFirst :: Bool) -> List Float64 is
  sets.eqSetItems (sets.eqSetOf (if negativeFirst
    then [float64Bits("8000000000000000"), float64Bits("0000000000000000")]
    else [float64Bits("0000000000000000"), float64Bits("8000000000000000")] end if))
end function

law "|creation retains first occurrences| is
  definition : for all (reverse :: Bool) =>
    sets.eqSetItems (sets.eqSetOf (arrivals reverse)) = expectedOrder reverse end for all end definition
end law

law "|new members append after the existing members| is
  definition : for all (reverse :: Bool) =>
    sets.eqSetItems (sets.eqSetInsert float64Bits("4008000000000000") (sets.eqSetOf (arrivals reverse))) =
    (if reverse then [float64Bits("4000000000000000"), float64Bits("3ff0000000000000"), float64Bits("4008000000000000")]
     else [float64Bits("3ff0000000000000"), float64Bits("4000000000000000"), float64Bits("4008000000000000")] end if) end for all end definition
end law

law "|inserting an existing member preserves iteration order| is
  definition : for all (reverse :: Bool) =>
    sets.eqSetItems (sets.eqSetInsert float64Bits("3ff0000000000000") (sets.eqSetOf (arrivals reverse))) = expectedOrder reverse end for all end definition
end law

law "|removing a member preserves relative order| is
  definition : for all (reverse :: Bool) =>
    sets.eqSetItems (sets.eqSetRemove float64Bits("3ff0000000000000") (sets.eqSetOf (arrivals reverse))) = [float64Bits("4000000000000000")] end for all end definition
end law

law "|union retains left arrivals before new right arrivals| is
  definition : for all (reverse :: Bool) =>
    sets.eqSetItems (sets.eqSetUnion (sets.eqSetOf [2, 1]) (sets.eqSetOf [1, 3])) = [2, 1, 3] end for all end definition
end law

law "|intersection preserves left iteration order| is
  definition : for all (reverse :: Bool) =>
    sets.eqSetItems (sets.eqSetIntersection (sets.eqSetOf [3, 1, 2]) (sets.eqSetOf [2, 3])) = [3, 2] end for all end definition
end law

law "|difference preserves left iteration order| is
  definition : for all (reverse :: Bool) =>
    sets.eqSetItems (sets.eqSetDifference (sets.eqSetOf [3, 1, 2]) (sets.eqSetOf [2, 3])) = [1] end for all end definition
end law

law "|NaNs remain separate while signed zeros deduplicate| is
  definition : for all (reverse :: Bool) =>
    sets.eqSetSize (sets.eqSetOf [float64Bits("7ff8000000000001"), float64Bits("7ff8000000000001"),
      float64Bits("0000000000000000"), float64Bits("8000000000000000")]) = 3 end for all end definition
end law

law "|NaN is not an equal member| is
  definition : for all (reverse :: Bool) =>
    sets.eqSetMember float64Bits("7ff8000000000001") (sets.eqSetOf [float64Bits("7ff8000000000001")]) = false end for all end definition
end law

law "|symbols deduplicate by identity rather than description| is
  definition : for all (reverse :: Bool) =>
    sets.eqSetSize (sets.eqSetOf [symbol("first", "same"), symbol("second", "same"), symbol("first", "same")]) = 2 end for all end definition
end law

law "|removing NaN does not remove an unequal stored value| is
  definition : for all (reverse :: Bool) =>
    sets.eqSetSize (sets.eqSetRemove float64Bits("7ff8000000000001")
      (sets.eqSetOf [float64Bits("7ff8000000000001")])) = 1 end for all end definition
end law

law "|empty sets have zero size| is
  definition : for all (reverse :: Bool) => sets.eqSetSize (emptyFloatSet reverse) = 0 end for all end definition
end law

law "|empty sets report empty| is
  definition : for all (reverse :: Bool) => sets.eqSetIsEmpty (emptyFloatSet reverse) = true end for all end definition
end law
end unit
