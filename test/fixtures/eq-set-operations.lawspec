-- Internal checked operations; canonical exports and notation remain separate.
unit example.eq_sets
import lawspec.collections as sets (EqSet)

definition arrivals (reverse :: Bool) :: List Float64 is
  if reverse then [float64Bits("4000000000000000"), float64Bits("3ff0000000000000"), float64Bits("4000000000000000")]
  else [float64Bits("3ff0000000000000"), float64Bits("4000000000000000"), float64Bits("3ff0000000000000")]
end

definition expectedOrder (reverse :: Bool) :: List Float64 is
  if reverse then [float64Bits("4000000000000000"), float64Bits("3ff0000000000000")]
  else [float64Bits("3ff0000000000000"), float64Bits("4000000000000000")]
end

definition emptyFloatSet (unused :: Bool) :: EqSet Float64 is sets.eqSetOf [] end

definition preservedZero (negativeFirst :: Bool) :: List Float64 is
  sets.eqSetItems (sets.eqSetOf (if negativeFirst
    then [float64Bits("8000000000000000"), float64Bits("0000000000000000")]
    else [float64Bits("0000000000000000"), float64Bits("8000000000000000")]))
end

law `creation retains first occurrences` is
  definition is `for all` (reverse :: Bool) .
    sets.eqSetItems (sets.eqSetOf (arrivals reverse)) = expectedOrder reverse end
end

law `new members append after the existing members` is
  definition is `for all` (reverse :: Bool) .
    sets.eqSetItems (sets.eqSetInsert float64Bits("4008000000000000") (sets.eqSetOf (arrivals reverse))) =
    (if reverse then [float64Bits("4000000000000000"), float64Bits("3ff0000000000000"), float64Bits("4008000000000000")]
     else [float64Bits("3ff0000000000000"), float64Bits("4000000000000000"), float64Bits("4008000000000000")]) end
end

law `inserting an existing member preserves iteration order` is
  definition is `for all` (reverse :: Bool) .
    sets.eqSetItems (sets.eqSetInsert float64Bits("3ff0000000000000") (sets.eqSetOf (arrivals reverse))) = expectedOrder reverse end
end

law `removing a member preserves relative order` is
  definition is `for all` (reverse :: Bool) .
    sets.eqSetItems (sets.eqSetRemove float64Bits("3ff0000000000000") (sets.eqSetOf (arrivals reverse))) = [float64Bits("4000000000000000")] end
end

law `union retains left arrivals before new right arrivals` is
  definition is `for all` (reverse :: Bool) .
    sets.eqSetItems (sets.eqSetUnion (sets.eqSetOf [2, 1]) (sets.eqSetOf [1, 3])) = [2, 1, 3] end
end

law `intersection preserves left iteration order` is
  definition is `for all` (reverse :: Bool) .
    sets.eqSetItems (sets.eqSetIntersection (sets.eqSetOf [3, 1, 2]) (sets.eqSetOf [2, 3])) = [3, 2] end
end

law `difference preserves left iteration order` is
  definition is `for all` (reverse :: Bool) .
    sets.eqSetItems (sets.eqSetDifference (sets.eqSetOf [3, 1, 2]) (sets.eqSetOf [2, 3])) = [1] end
end

law `NaNs remain separate while signed zeros deduplicate` is
  definition is `for all` (reverse :: Bool) .
    sets.eqSetSize (sets.eqSetOf [float64Bits("7ff8000000000001"), float64Bits("7ff8000000000001"),
      float64Bits("0000000000000000"), float64Bits("8000000000000000")]) = 3 end
end

law `NaN is not an equal member` is
  definition is `for all` (reverse :: Bool) .
    sets.eqSetMember float64Bits("7ff8000000000001") (sets.eqSetOf [float64Bits("7ff8000000000001")]) = false end
end

law `symbols deduplicate by identity rather than description` is
  definition is `for all` (reverse :: Bool) .
    sets.eqSetSize (sets.eqSetOf [symbol("first", "same"), symbol("second", "same"), symbol("first", "same")]) = 2 end
end

law `removing NaN does not remove an unequal stored value` is
  definition is `for all` (reverse :: Bool) .
    sets.eqSetSize (sets.eqSetRemove float64Bits("7ff8000000000001")
      (sets.eqSetOf [float64Bits("7ff8000000000001")])) = 1 end
end

law `empty sets have zero size` is
  definition is `for all` (reverse :: Bool) . sets.eqSetSize (emptyFloatSet reverse) = 0 end
end

law `empty sets report empty` is
  definition is `for all` (reverse :: Bool) . sets.eqSetIsEmpty (emptyFloatSet reverse) = true end
end
