unit example.rc1.lawMetadata

type Review is one of
  | Approved
  | Declined
end type

function review (allowed of type Bool) -> Review is
  if allowed then Approved else Declined end if
end function

law "|allowed requests are approved| is
  id: "REVIEW-001"
  owner: Payments.Review
  description:
    "An allowed request receives approval."
  end description
  definition:
    review true must be Approved
  end definition
end law

law "|other requests are declined| is
  owner: Payments.Review
  id: "REVIEW-002"
  definition:
    review false must be Declined
  end definition
end law
end unit
