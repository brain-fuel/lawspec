unit authoring.integerArithmetic

function square (value of type Int8) -> Integer is
  value * value
end function

function reciprocal (value of type Integer where value != 0) -> Rational is
  1 / value
end function

law "|squares are nonnegative| is
  definition:
    for all (value of type Int8 where value >= -3 and value <= 3) =>
      square value >= 0
    end for all
  end definition

  expect square value = expected
  in table (value, expected):
    row -3, 9
    row 0, 0
    row 3, 9
  end table
end law

law "|every selected integer has a successor| is
  definition:
    for all (value of type Int8 where value >= -3 and value <= 3) =>
      there exists
        (candidate of type Int8 where candidate >= value and candidate <= value + 1)
      such that
        candidate > value
      end exists
    end for all
  end definition
end law

law "|no integer has a negative square| is
  definition:
    there does not exist (value of type Int8) such that
      square value < 0
    end exists
  end definition
end law

law "|a nonzero integer has an exact reciprocal| is
  definition:
    for all (value of type Int8 where value != 0) =>
      reciprocal value * value must be 1
    end for all
  end definition

  expect reciprocal value = expected
  in table (value, expected):
    row -2, rational(-1, 2)
    row -1, -1
    row 1, 1
    row 2, rational(1, 2)
  end table
end law
end unit
