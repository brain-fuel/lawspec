unit example.refinedPayloads

type Measurement (a of type Type) is a record{
  reading of type record{value of type a}
}
end type

type Parcel is a record{
  details of type record{
    weight of type (measurement of type Measurement Integer
      where measurement.reading.value > 0)
  }
}
end type

type DeliveryLabel is a record{
  code of type UInt8
  recipient of type Text
}
end type

type Delivery (a of type Type) is a record{
  contents of type record{value of type a}
}
end type

function sampleParcel (unused of type ()) -> Parcel is
  Parcel record{details = record{
    weight = Measurement record{reading = record{value = 1}}
  }}
end function

function weightOf (parcel of type record{
  weight of type (measurement of type Measurement Integer
    where measurement.reading.value > 0)
}) -> Integer is
  parcel.weight.reading.value
end function

function recipient (delivery of type Delivery DeliveryLabel) -> Text is
  delivery.contents.value.recipient
end function

law sampleWeight is
  description:
    "A sample parcel weighs one gram."
  end description
  definition:
    sampleParcel () must be Parcel record{details = record{
      weight = Measurement record{reading = record{value = 1}}
    }}
  end definition
end law

law positiveWeights is
  description:
    "Every accepted parcel measurement has a positive weight."
  end description
  definition:
    for all (parcel of type record{
      weight of type (measurement of type Measurement Integer
        where measurement.reading.value > 0)
    }) =>
      weightOf parcel > 0
    end for all
  end definition
  expect weightOf parcel = expected
  in table (parcel, expected):
    row record{weight = Measurement record{reading = record{value = 1}}}, 1
    row record{weight = Measurement record{reading = record{value = 3}}}, 3
  end table
end law

law recipientLabels is
  description:
    "Deliveries preserve the recipient written on their label."
  end description
  definition:
    for all (delivery of type Delivery DeliveryLabel) =>
      recipient delivery = recipient delivery
    end for all
  end definition
  expect recipient delivery = expected
  in table (delivery, expected):
    row Delivery record{contents = record{value = DeliveryLabel record{
      recipient = "Asha", code = 7
    }}}, "Asha"
    row Delivery record{contents = record{value = DeliveryLabel record{
      code = 8, recipient = "Bo"
    }}}, "Bo"
  end table
end law
end unit
