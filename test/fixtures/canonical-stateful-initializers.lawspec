unit signals.initializers

ability Signal is
  flip of type () -> Bool
  remember of type () -> Bool -> () -> Bool
  clear of type () -> ()
  current of type Bool
end ability

handler binding for Signal with state enabled of type Bool
  start let initiallyDisabled = false in initiallyDisabled end let is
  operation flip ignored is ~enabled := not enabled; enabled end operation
  operation remember before value after is ~enabled := value; enabled end operation
  operation clear ignored is ~enabled := false; () end operation
  operation current is enabled end operation
end handler

handler conditional for Signal with state enabled of type Bool
  start if true then false else true end if is
  operation flip ignored is ~enabled := not enabled; enabled end operation
  operation remember before value after is ~enabled := value; enabled end operation
  operation clear ignored is ~enabled := false; () end operation
  operation current is enabled end operation
end handler

handler matching for Signal with state enabled of type Bool
  start first matching case of true:
    when true then false
    when false then true
  end case is
  operation flip ignored is ~enabled := not enabled; enabled end operation
  operation remember before value after is ~enabled := value; enabled end operation
  operation clear ignored is ~enabled := false; () end operation
  operation current is enabled end operation
end handler

procedure twice (ignored of type ()) -> Bool uses Signal is
  flip ignored; flip ignored
end procedure

function bindingFirstFlip (ignored of type ()) -> Bool is
  handle flip ignored with binding end handle
end function

function conditionalFirstFlip (ignored of type ()) -> Bool is
  handle flip ignored with conditional end handle
end function

function matchingFirstFlip (ignored of type ()) -> Bool is
  handle flip ignored with matching end handle
end function

law bindingFirst is
  description: "The first flip enables a signal initialized by a binding." end description
  definition: for all (ignored of type ()) => bindingFirstFlip ignored must be true end for all end definition
  expect bindingFirstFlip ignored = expected
  in table (ignored, expected): row (), true end table
end law

law bindingTwice using binding is
  definition: for all (ignored of type ()) => twice ignored must be false end for all end definition
  expect twice ignored = expected
  in table (ignored, expected): row (), false end table
end law

law conditionalFirst is
  description: "The first flip enables a signal initialized by a conditional." end description
  definition: for all (ignored of type ()) => conditionalFirstFlip ignored must be true end for all end definition
  expect conditionalFirstFlip ignored = expected
  in table (ignored, expected): row (), true end table
end law

law conditionalTwice using conditional is
  definition: for all (ignored of type ()) => twice ignored must be false end for all end definition
  expect twice ignored = expected
  in table (ignored, expected): row (), false end table
end law

law matchingFirst is
  description: "The first flip enables a signal initialized by a case." end description
  definition: for all (ignored of type ()) => matchingFirstFlip ignored must be true end for all end definition
  expect matchingFirstFlip ignored = expected
  in table (ignored, expected): row (), true end table
end law

law matchingTwice using matching is
  definition: for all (ignored of type ()) => twice ignored must be false end for all end definition
  expect twice ignored = expected
  in table (ignored, expected): row (), false end table
end law

function selected (left of type Bool) (right of type Bool) -> Bool is
  not left = false && right = false
end function

law selection is
  definition:
    for all (left of type Bool) (right of type Bool) =>
      selected left right must be (left and not right)
    end for all
  end definition
  expect selected left right = expected
  in table (left, right, expected):
    row false, false, false
    row false, true, false
    row true, false, true
    row true, true, false
  end table
end law

handler fixed for Signal is
  operation flip ignored is true end operation
  operation remember before value after is value end operation
  operation clear ignored is () end operation
  operation current is true end operation
end handler

function remembered (flag of type Bool) -> Bool is
  handle remember () flag () with binding end handle
end function

function clearedBeforeFlip (ignored of type ()) -> Bool is
  handle (remember () true (); flip (clear ())) with binding end handle
end function

function currentAfterRemembering (flag of type Bool) -> Bool is
  handle (remember () flag (); current) with matching end handle
end function

law unitsSurroundRememberedValue is
  definition: for all (flag of type Bool) => remembered flag must be flag end for all end definition
  expect remembered flag = expected
  in table (flag, expected): row false, false row true, true end table
end law

law argumentIsEvaluatedBeforeFlip is
  definition: for all (ignored of type ()) => clearedBeforeFlip ignored must be true end for all end definition
  expect clearedBeforeFlip ignored = expected
  in table (ignored, expected): row (), true end table
end law

law operationWithoutArguments is
  definition: for all (flag of type Bool) => currentAfterRemembering flag must be flag end for all end definition
  expect currentAfterRemembering flag = expected
  in table (flag, expected): row false, false row true, true end table
end law

law statelessArguments using fixed is
  definition: for all (flag of type Bool) => remember () flag () must be flag end for all end definition
  expect remember () flag () = expected
  in table (flag, expected): row false, false row true, true end table
end law

function unitTruth (ignored of type ()) -> Bool is
  true
end function

law pureUnitArgument is
  definition: for all (ignored of type ()) => unitTruth ignored must be true end for all end definition
  expect unitTruth ignored = expected
  in table (ignored, expected): row (), true end table
end law
type InitialReading is a record{
  count of type Int64
  factor of type Float64
}
end type

ability Reading is
  currentCount of type Int64
  currentFactor of type Float64
end ability

handler literalRecord for Reading with state reading of type InitialReading
  start InitialReading record{count = 3, factor = 2.5} is
  operation currentCount is reading.count end operation
  operation currentFactor is reading.factor end operation
end handler

law literalFieldsRemainIndependent using literalRecord is
  description:
    "A literal record initializes each field with its own value and type."
  end description
  definition:
    currentCount must be 3 and currentFactor must be 2.5
  end definition
end law

end unit
