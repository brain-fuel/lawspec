unit native.fields

type Gap is a record{
   first :: Int8 second :: (n :: Int8 where n > first)}
end type

type Identity is a record{
   value :: (s :: Symbol where s = symbol("fixture", "same"))}
end type

type Bucket (a :: Type) is a record{
   values :: (xs :: List a where prelude.length xs > 0)}
end type

type Positives is a record{
   values :: List (n :: Int8 where n > 0)}
end type

type Choice is one of
  Accepted  of type (n :: Int8 where n > 0)
  Rejected  of type Text
end type

type Machine is a record{
   value :: (n :: IntSize where n > 0)}
end type

function inverseGap (gap :: Gap) -> Rational is
  first matching case of gap : when Gap record{ first = x , second = y} then 1 / (y - x) end case
end function

function echoIdentity (box :: Identity) -> Identity is box end function
function echoBucket (box :: Bucket Int8) -> Bucket Int8 is box end function
function echoPositives (box :: Positives) -> Positives is box end function
function echoChoice (box :: Choice) -> Choice is box end function
function echoMachine (box :: Machine) -> Machine is box end function

type Guarded is a record{
   value :: (n :: Int8 where n != 0 && 1 / n > 0)}
end type

function echoGuarded (box :: Guarded) -> Guarded is box end function

echoAdapter :: Identity -> Identity
law "|adapter identity| is definition : for all (x :: Identity) => echoAdapter x = x end for all end definition end law
law "|positive gap| is definition : for all (x :: Gap) => inverseGap x > 0 end for all end definition end law
law "|fixture identity| is definition : for all (x :: Identity) => echoIdentity x = x end for all end definition end law
law "|nonempty bucket| is definition : for all (x :: Bucket Int8) => echoBucket x = x end for all end definition end law
law "|positive elements| is definition : for all (x :: Positives) => echoPositives x = x end for all end definition end law
law "|sum alternatives| is definition : for all (x :: Choice) => echoChoice x = x end for all end definition end law
law "|machine field| is definition : for all (x :: Machine) => echoMachine x = x end for all end definition end law
law "|guarded field| is definition : for all (x :: Guarded) => echoGuarded x = x end for all end definition end law
law "|mixed fixture inputs| is definition :
  for all (x :: Identity) (s :: Symbol where s = symbol("fixture", "same")) =>
  echoIdentity x = x end for all
end definition end law
law "|dependent fixture inputs| is definition :
  for all (x :: Identity) (s :: Symbol where s = symbol("fixture", "same"))
    (t :: Symbol where t = s) => s = t end for all
end definition end law
law "|nested identities| is definition : for all (xs :: List Identity) => xs = xs end for all end definition end law

type Flag is a record{
   enabled :: (b :: Bool where b)}
end type

law "|finite field domain| is
  definition : for all (x :: Flag) => x = x end for all end definition
end law

law "|nullable identity| is
  definition : for all (x :: Nullable Identity) => x = x end for all end definition
end law

law "|optional identity| is
  definition : for all (x :: Optional Identity) => x = x end for all end definition
end law
end unit
