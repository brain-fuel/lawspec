unit example.dependentModel

type Stack (n :: Whole) is one of
  | Empty where n = 0
  | Push of type record{ top :: Int8 rest :: Stack m } where n = m + 1
end type
empty :: Unit -> Stack 0
push :: Stack n / Stack (n + 1) -> Unit
chooseAt :: Stack n / Stack n -> (i :: Int8 where i >= 0 && i < n) -> Int8
clear :: Stack n / Stack 0 -> Unit

function modelPush (xs :: List Int8) -> List Int8 is Cons 0 xs end function
function modelSelect (i :: Int8) (xs :: List Int8) -> Pair Int8 (List Int8) is Pair record{first = i, second = xs} end function
function modelClear (xs :: List Int8) -> List Int8 is Nil end function
function short (xs :: List Int8) -> Bool is prelude.length xs < 2 end function
function bounded (xs :: List Int8) -> Bool is prelude.length xs <= 2 end function

model stack :: Stack n by List Int8 is
  start empty ~ Nil
  push ~ modelPush when short
  chooseAt ~ modelSelect
  clear ~ modelClear
end model

law "|bounded runs| in model stack is
  definition: every run holds always bounded end definition
end law
end unit
