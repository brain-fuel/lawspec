unit example.total

type Tree is one of Leaf  of type Int8 | Branch of type record{ left :: Tree right :: Tree} end type
type Architecture is one of Unused | Native  of type IntSize end type

function size (xs :: List Int8) -> Integer is
  first matching case of xs : when Nil then 0 when Cons head tail then 1 + size tail end case
end function

function sumList (xs :: List Int8) -> Integer is
  first matching case of xs : when Nil then 0 when Cons head tail then head + sumList tail end case
end function

function sumTree (tree :: Tree) -> Integer is
  first matching case of tree : when Leaf value then value + 0 when Branch record{ left = left , right = right} then sumTree left + sumTree right end case
end function

function forward (xs :: List Int8) -> Integer is size xs end function

function divisible (x :: Integer) (y :: Integer) -> Bool is
  y != 0 && prelude.rem x y = 0
end function

function increment (x :: Int8) -> Integer is x + 1 end function

function maybeDefault (x :: Maybe Int8) -> Int8 is
  first matching case of x : when Absent then 0 when Present value then value end case
end function

function raw (x :: List CodeUnit16) -> List CodeUnit16 is x end function

function absent (x :: Optional (Nullable Int8)) -> Optional (Nullable Int8) is x end function

function machine (x :: IntSize) -> IntSize is x end function

function architecture (x :: Architecture) -> Architecture is x end function

function symbol (x :: Unit) -> Symbol is symbol("same", "description") end function

function exact (x :: Decimal) -> Decimal is x + 0.2 end function

function either (x :: Either Int8 Bool) -> Either Int8 Bool is
  first matching case of x : when Left n then Left n when Right b then Right b end case
end function

actualSum :: (xs :: List Int8 where sumList xs = sumList xs)
          -> (result :: Integer where result = sumList xs)
actualIncrement :: Int8 -> Integer
actualTree :: Tree -> Integer

law "|native sum agrees with checked definition| is
  definition : for all (xs :: List Int8) => actualSum xs = sumList xs end for all end definition
  example "|beyond Int8| : xs = [127, 127] expect sumList xs = 254 end example
end law
law "|native increment promotes| is
  definition : for all (x :: Int8) => actualIncrement x = increment x end for all end definition
  example "|maximum| : x = 127 expect increment x = 128 end example
end law
law "|native tree agrees with checked definition| is
  definition : for all (x :: Tree) => actualTree x = sumTree x end for all end definition
end law
law "|list length| is
  definition : for all (xs :: List Int8) => forward xs = prelude.length xs end for all end definition
end law
law "|safe division| is
  definition : for all (x :: Integer) => divisible x 0 = false end for all end definition
end law
law "|constructor identity| is
  definition : for all (x :: Either Int8 Bool) => either x = x end for all end definition
end law

function guardedReciprocal (x :: Int8) -> Bool is
  x >= 0 && 1 / (x + 1) > 0
end function

law "|affine denominator stays nonzero under its guard| is
  definition :
    for all (x :: Int8) => guardedReciprocal x = (x >= 0) end for all
  end definition
  example "|zero denominator is skipped| :
    x = -1 expect guardedReciprocal x = false
  end example
  example "|promoted denominator| :
    x = 127 expect guardedReciprocal x = true
  end example
end law

function guardedNarrow (x :: Int8) -> Bool is
  x < 127 && prelude.Int8 (x + 1) > x
end function

law "|guarded conversion preserves the promoted result| is
  definition :
    for all (x :: Int8) => guardedNarrow x = (x < 127) end for all
  end definition
  example "|skip overflow| : x = 127 expect guardedNarrow x = false end example
  example "|largest valid conversion| : x = 126 expect guardedNarrow x = true end example
end law

function reciprocalHead (xs :: List Int8) -> Rational is
  first matching case of xs :
    when Nil then 0
    when Cons head tail then 1 / (head + 129)
  end case
end function

law "|matched Int8 fields keep their range| is
  definition :
    for all (xs :: List Int8) => reciprocalHead xs >= 0 end for all
  end definition
  example "|empty list| : xs = [] expect reciprocalHead xs = rational(0, 1) end example
  example "|minimum field| : xs = [-128] expect reciprocalHead xs = rational(1, 1) end example
  example "|maximum field| : xs = [127] expect reciprocalHead xs = rational(1, 256) end example
end law
end unit
