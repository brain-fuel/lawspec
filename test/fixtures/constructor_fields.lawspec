unit fixture.constructor_fields

-- Front-end/reference fixture. Native generation remains gated until each
-- runtime and generator enforces the field invariants.
type Gap is a record{
   first :: Int8 second :: (n :: Int8 where n > first)}
end type

function inverseGap (gap :: Gap) -> Rational is
  first matching case of gap : when Gap record{ first = x , second = y} then 1 / (y - x) end case
end function

law "|dependent stored fields| is
  definition : for all (gap :: Gap) => inverseGap gap > 0 end for all end definition
  example "|widest gap| :
    gap = Gap record{ first = -128 , second = 127}
    expect inverseGap gap = rational(1, 255)
  end example
end law
end unit
