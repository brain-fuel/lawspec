{
  :manifest-version 1
  :component {
    :name "csharp"
    :version "0.1.0"
  }
  :sources ["laws"]
  :machine-bits 64
  :targets [
    {
      :language :csharp
      :root "."
      :native-bindings {
        :functions [
          {
            :declaration "example.payments::addFee"
            :native ["Domain" "Payments" "ApplyFee"]
          }
          {
            :declaration "example.payments::roundTrip"
            :native ["Domain" "Payments" "Restore"]
          }
          {
            :declaration "example.payments::archive"
            :native ["Domain" "Payments" "Store"]
          }
        ]
        :generators [
          {
            :type "example.payments::type::Money"
            :factory ["Domain" "PaymentGenerators" "Prices"]
          }
        ]
      }
    }
  ]
  :language-profile "1.0-rc.2"
  :verification {
    :layers [
      :proof
      :exhaustive
      :property
      :examples
      :runtime
      :model
    ]
  }
}
