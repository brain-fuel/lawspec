unit example.delivery.rru

type PdfDetails is a record{
  fileName of type Text
  byteCount of type Whole
}
end type

type PlainTextDetails is a record{
  fileName of type Text
}
end type

type File is one of
  | Pdf of type PdfDetails
  | PlainText of type PlainTextDetails
end type

type Invoice is a record{
  number of type Text
  file of type File
}
end type

type EmailDelivery is a record{
  recipient of type Text
  document of type Invoice
}
end type

function "|email invoice PDF file name|
  (delivery of type EmailDelivery) -> Maybe Text is
  first matching case of delivery:
    when record{document = record{file = Pdf record{fileName = name}}}
      then Just name
    otherwise Nothing
  end case
end function

function emailPdfInvoice (name of type Text) -> EmailDelivery is
  EmailDelivery record{recipient = "accounts@example.com", document = Invoice
    record{number = "INV-2026-10", file = (Pdf (PdfDetails record{fileName =
        name,
        byteCount = 1200}))}}
end function

law "|emailPdfInvoice result| is
  description:
    "PDF invoices sent by email retain their file names."
  end
  definition:
    "|email invoice PDF file name| (emailPdfInvoice "invoice.pdf") must be Just
    "invoice.pdf"
  end
end

function emailPlainTextInvoice (name of type Text) -> EmailDelivery is
  EmailDelivery record{recipient = "accounts@example.com", document = Invoice
    record{number = "INV-2026-10", file = (PlainText (PlainTextDetails
      record{fileName = name}))}}
end function

law "|emailPlainTextInvoice result| is
  description:
    "Plain-text invoices have no PDF file name."
  end
  definition:
    "|email invoice PDF file name| (emailPlainTextInvoice "invoice.pdf") must be
    Nothing
  end
end
