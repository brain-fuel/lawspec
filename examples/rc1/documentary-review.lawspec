unit example.rc1.documentaryReview

type Review is one of
  | Approved
  | Declined
end type

function review (allowed of type Bool) -> Review is
  if allowed then Approved else Declined end if
end function

law "|allowed requests are approved| is
  id: "REVIEW-001"
  owner: Payments.Review
  description:
    "An allowed request receives approval."
  end description
  definition:
    review true must be Approved
  end definition
  references:
    #S{ref law "|other requests are declined| description,
       ref function review}
    ref law "|other requests are declined| references."|Review policy|
    "|Review policy|: "Allowed requests are approved; all other requests are declined."
  end references
end law

law "|other requests are declined| is
  owner: Payments.Review
  id: "REVIEW-002"
  description:
    "A request without permission receives a decline."
  end description
  definition:
    review false must be Declined
  end definition
  references:
    ref law "|allowed requests are approved| definition
    "|Review policy|: "Allowed requests are approved; all other requests are declined."
  end references
end law
end unit
