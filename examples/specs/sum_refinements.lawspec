unit example.sum_refinements

law "|positive Maybe payloads| is
  definition : for all (x :: Maybe (value :: Int8 where value > 0)) =>
    (first matching case of x : when Absent then true when Present payload then payload >= 1 end case) = true end for all
  end definition
  example "|absent| : x = Absent expect x = Absent end example
  example "|present| : x = Present 1 expect x = Present 1 end example
end law

law "|selected Either payload| is
  definition : for all
    (x :: Either (value :: Int8 where value > 0) (value :: Int8 where value < 0)) =>
    (first matching case of x : when Left payload then payload >= 1 when Right payload then payload <= -1 end case) = true end for all
  end definition
  example "|left| : x = Left 1 expect x = Left 1 end example
  example "|right| : x = Right -1 expect x = Right -1 end example
end law

law "|nested Maybe states| is
  definition : for all (x :: Maybe (Maybe (value :: Bool where value))) =>
    (first matching case of x : when Absent then true when Present inner then
      first matching case of inner : when Absent then true when Present payload then payload end case
    end case) = true end for all
  end definition
  example "|outer absent| : x = Absent expect x = Absent end example
  example "|inner absent| : x = Present Absent expect x = Present Absent end example
  example "|present| : x = Present (Present true) expect x = Present (Present true) end example
end law

law "|finite Either variants| is
  definition : for all
    (x :: Either (value :: Bool where value) (value :: Bool where !value)) =>
    (first matching case of x : when Left payload then payload when Right payload then !payload end case) = true end for all
  end definition
end law

law "|dependent payload keeps outer binding| is
  definition : for all (lawspecElement :: Int8)
    (x :: Maybe (value :: Int8 where value > lawspecElement)) =>
    (first matching case of x : when Absent then true when Present payload then payload - lawspecElement >= 1 end case) = true end for all
  end definition
  example "|maximum prefix has absent continuation| :
    lawspecElement = 127 x = Absent expect x = Absent
  end example
  example "|present continuation| :
    lawspecElement = 0 x = Present 1 expect x = Present 1
  end example
end law
end unit
