unit example.flow

type Stack (n :: Whole) is one of
  | Empty where n = 0
  | Push of type record{ top :: Int8 rest :: Stack m} where n = m + 1
end type

-- A / A' is a flow parameter: the call takes the stack from A to A'. Each
-- adapter returns its result with the stack it leaves, as a generated
-- product (PushFlow, PopFlow, PeekFlow); the stack's index is checked.
push :: (x :: Int8) -> Stack n / Stack (n + 1) -> Unit
pop :: Stack (n + 1) / Stack n -> Int8
peek :: Stack (n + 1) / Stack (n + 1) -> Int8

-- A reference definition updates its flow parameter with ~s := e.
function pushed (x :: Int8) (s :: Stack n / Stack (n + 1)) -> Unit is
  ~s := Push record{ top = x , rest = s}
end function

-- ~s passes s to a flow parameter and rebinds s to the stack the call
-- leaves; e1; e2 sequences, left to right. pop needs Stack (m + 1): after
-- push, s is a Stack (n + 1), so the pop below type-checks.
law "|pop returns what push pushed| is
  definition :
    for all (x :: Int8) (s :: Stack n) => (push x ~s; pop ~s) = x end for all
  end definition
end law

law "|push grows the stack| is
  definition :
    for all (x :: Int8) (s :: Stack n) => (push x ~s; nOfStack s) = n + 1 end for all
  end definition
end law

law "|pops come back in reverse| is
  definition :
    for all (x :: Int8) (y :: Int8) (s :: Stack n) =>
      (push x ~s; push y ~s; pop ~s; pop ~s) = x end for all
  end definition
end law

-- The quantifier's index k + 1 lets peek and pop take s.
law "|peek and pop agree| is
  definition :
    for all (s :: Stack (k + 1)) => peek ~s = pop ~s end for all
  end definition
end law

law "|pop shrinks the stack| is
  definition :
    for all (s :: Stack (k + 1)) => (pop ~s; nOfStack s) = k end for all
  end definition
end law

law "|push agrees with the reference| is
  definition :
    for all (x :: Int8) (s :: Stack n) => (pushed x ~s; pop ~s) = x end for all
  end definition
end law

-- A function may take several flow parameters: pushBoth takes two stacks and
-- leaves each one higher. A call passes ~a ~b, rebinding each.
function pushBoth (x :: Int8) (a :: Stack n / Stack (n + 1)) (b :: Stack m / Stack (m + 1)) -> Unit is
  ~a := Push record{ top = x , rest = a}; ~b := Push record{ top = x , rest = b}
end function

law "|both stacks get the value| is
  definition :
    for all (x :: Int8) (a :: Stack n) (b :: Stack m) => (pushBoth x ~a ~b; pop ~a; pop ~b) = x end for all
  end definition
end law

-- A flow call may sit in a branch of an if or a match, when every branch
-- leaves the stack at the same type: here each branch pushes once.
law "|a push in each branch| is
  definition :
    for all (x :: Int8) (s :: Stack n) =>
      ((if x > 0 then push x ~s else push 0 ~s end if); pop ~s) = (if x > 0 then x else 0 end if) end for all
  end definition
end law

law "|a push chosen by a match| is
  definition :
    for all (m :: Maybe Int8) (s :: Stack n) =>
      ((first matching case of m :
        when Just v then push v ~s
        when Nothing then push 0 ~s
        end case); pop ~s) = (first matching case of m :
                          when Just v then v
                          when Nothing then prelude.Int8 0
                          end case) end for all
  end definition
end law
end unit
