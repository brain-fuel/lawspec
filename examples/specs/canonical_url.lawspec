unit example.canonical_url

canonicalize :: Text -> Text

law `canonicalization reaches a fixed point` is
  definition is
    `idempotent` canonicalize
  end
  description is
    "{canonicalize} removes trailing slashes until the result is stable"
  end
  example `all trailing slashes are removed in one pass` is
    x = "https://example.com/path///"
    expect canonicalize x = "https://example.com/path"
  end
  example `a URL without trailing slashes stays unchanged` is
    x = "https://example.com/path"
    expect canonicalize x = "https://example.com/path"
  end
  example `empty input remains empty` is
    x = ""
    expect canonicalize x = ""
  end
end
