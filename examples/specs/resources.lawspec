unit example.resources

-- A resource is something a law needs that lives outside the program: a
-- store, a directory, a port. Each case of a law acquires its resources
-- first and releases them after, even when the case fails, so every case
-- starts afresh and nothing leaks.

-- A store the tests open, use and close. Only adapters make one.
handle Store

openStore :: Unit -> Store
closeStore :: Store -> Unit
clearStore :: Store -> Unit
put :: Store -> Int32 -> Int32 -> Unit
get :: Store -> Int32 -> Maybe Int32
isOpen :: Store -> Bool
size :: Store -> Int32

resource Store is
  acquire is openStore unitValue end acquire
  release store is closeStore store end release
  reset store is clearStore store end reset
end resource

law "|a stored value can be read back| for store :: Store is
  definition :
    for all (k :: Int32) (v :: Int32) => put store k v = unitValue and get store k = Present v end for all
  end definition
  example "|the store is open while the case runs| :
    k = 1
    v = 2
    expect isOpen store
  end example
end law

law "|every case gets an empty store| for store :: Store is
  definition :
    for all (k :: Int32) (v :: Int32) =>
      size store = 0 and put store k v = unitValue and size store = 1 end for all
  end definition
end law

-- Built-in resources: a temporary directory, a free port, and the
-- environment, saved and restored.
writeNote :: Text -> Int32 -> Unit
readNote :: Text -> Maybe Int32
canListen :: Int32 -> Bool
setGreeting :: Int32 -> Unit
greeting :: Unit -> Maybe Int32

law "|a note reads back| for dir :: TemporaryDirectory is
  definition :
    for all (n :: Int32) =>
      writeNote (directoryPath dir) n = unitValue and readNote (directoryPath dir) = Present n end for all
  end definition
end law

law "|a new directory has no note| for dir :: TemporaryDirectory is
  definition :
    readNote (directoryPath dir) = Absent
  end definition
end law

law "|a free port can be listened on| for port :: FreePort is
  definition :
    canListen (portNumber port) = true
  end definition
end law

law "|the greeting is the one set| for saved :: SavedEnvironment is
  definition :
    for all (n :: Int32) => setGreeting n = unitValue and greeting unitValue = Present n end for all
  end definition
end law

law "|the environment is restored after each case| for saved :: SavedEnvironment is
  definition :
    greeting unitValue = Absent
  end definition
end law

-- A pool is costly to open, so the harness shares one between the cases of
-- this unit's laws. Sharing is allowed only because Pool declares reset:
-- every case after the first gets the pool drained, so no case sees what
-- another left in it, and the law means the same as with a fresh pool.
handle Pool

openPool :: Unit -> Pool
drainPool :: Pool -> Unit
closePool :: Pool -> Unit
fill :: Pool -> Int32 -> Unit
level :: Pool -> Int32

resource Pool is
  acquire is openPool unitValue end acquire
  release pool is closePool pool end release
  reset pool is drainPool pool end reset
end resource

law "|a pool starts each case empty| for pool :: Pool is
  definition :
    for all (n :: Int32 where n > 0 && n <= 100) =>
      level pool = 0 and fill pool n = unitValue and level pool = n end for all
  end definition
end law

law "|filling twice adds up| for pool :: Pool is
  definition :
    for all (a :: Int32 where a > 0 && a <= 100) (b :: Int32 where b > 0 && b <= 100) =>
      fill pool a = unitValue and fill pool b = unitValue and level pool = a + b end for all
  end definition
end law

harness example.resources.testing for example.resources is
  share Pool per unit
end harness
end unit
