unit example.nativeAgreement

-- Each target runs the list operations with its own loops. These laws check
-- that every one gives the result of its definition in lawspec.instances.

import lawspec.instances (mapList, mapEither, filterList, foldLeftList,
  foldRightList, allList, anyList, lengthList, appendList, concatList)

function double (n :: Integer) -> Integer is n * 2 end function

function isEven (n :: Integer) -> Bool is prelude.rem n 2 = 0 end function

function minus (a :: Integer) (b :: Integer) -> Integer is a - b end function

function halved (n :: Integer) -> Either Text Integer is
  if isEven n then Right (prelude.quot n 2) else Left "odd" end if
end function

law "|the definitions give the expected results| is
  definition :
    mapList double [1, 2, 3] = [2, 4, 6]
    and filterList isEven [1, 2, 3, 4] = [2, 4]
    and foldLeftList minus 10 [1, 2, 3] = 4
    and foldRightList minus 10 [1, 2, 3] = -8
    and allList isEven [2, 4] and not allList isEven [2, 3]
    and anyList isEven [1, 2] and not anyList isEven [1, 3]
    and lengthList [7, 8, 9] = 3
    and appendList [1] [2, 3] = [1, 2, 3]
    and concatList [[1], [], [2, 3]] = [1, 2, 3]
    and mapEither double (halved 4) = Right 4
    and mapEither double (halved 3) = Left "odd"
  end definition
end law

law "|map agrees with its definition| is
  definition :
    for all (xs :: List Integer) =>
      prelude.map double xs = mapList double xs
    end for all
  end definition
end law

law "|map over an Either agrees with its definition| is
  definition :
    for all (n :: Integer) =>
      prelude.map double (halved n) = mapEither double (halved n)
    end for all
  end definition
end law

law "|filter agrees with its definition| is
  definition :
    for all (xs :: List Integer) =>
      prelude.filter isEven xs = filterList isEven xs
    end for all
  end definition
end law

law "|the folds agree with their definitions| is
  definition :
    for all (start :: Integer) (xs :: List Integer) =>
      prelude.foldLeft minus start xs = foldLeftList minus start xs
      and prelude.foldRight minus start xs = foldRightList minus start xs
    end for all
  end definition
end law

law "|all and any agree with their definitions| is
  definition :
    for all (xs :: List Integer) =>
      prelude.all isEven xs = allList isEven xs
      and prelude.any isEven xs = anyList isEven xs
    end for all
  end definition
end law

law "|length agrees with its definition| is
  definition :
    for all (xs :: List Integer) =>
      prelude.length xs = lengthList xs
    end for all
  end definition
end law

law "|append agrees with its definition| is
  definition :
    for all (xs :: List Integer) (ys :: List Integer) =>
      xs ++ ys = appendList xs ys
    end for all
  end definition
end law

law "|concat agrees with its definition| is
  definition :
    for all (xss :: List (List Integer)) =>
      prelude.concat xss = concatList xss
    end for all
  end definition
end law
end unit
