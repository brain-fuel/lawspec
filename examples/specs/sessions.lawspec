unit example.sessions

-- Protocols become typed channel ends on every target, for implementation
-- code: each step is its own type, so steps out of order do not compile,
-- and an end used twice fails. The adapters below implement adding with a
-- server process they talk to through those generated types.

-- What a server does: receive two numbers, send their sum. Its client holds
-- the other end, which does the reverse.
protocol Serve is
  receive Int32
  receive Int32
  send Int64
end

-- Handing a server's end to a worker (delegation).
protocol Hire is
  send Serve
end

-- Adds through a server process. Processes that talk over channels wait for
-- each other, so these adapters are asynchronous.
async add :: Int32 -> Int32 -> Integer

-- Adds through a worker that is handed the server's end over a Hire channel.
async addHired :: Int32 -> Int32 -> Integer

law `a server adds` is
  definition is
    `for all` (a :: Int32) (b :: Int32) . add a b = prelude.Integer a + prelude.Integer b
  end
end

law `a hired worker adds` is
  definition is
    `for all` (a :: Int32) (b :: Int32) . addHired a b = prelude.Integer a + prelude.Integer b
  end
end
