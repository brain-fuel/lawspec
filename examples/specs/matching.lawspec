unit example.matching

-- Rebuilding values checks both constructor identity and every payload field.
law "|list patterns preserve the head and tail| is
  definition :
    for all (xs :: List Int8) =>
      (first matching case of xs :
        when Nil then []
        when Cons head tail then Cons head tail
      end case) = xs end for all
  end definition
end law

law "|nested Maybe patterns preserve each absence state| is
  definition :
    for all (value :: Maybe (Maybe Bool)) =>
      (first matching case of value :
        when Absent then Absent
        when Present inner then Present (first matching case of inner :
            when Absent then Absent
            when Present payload then Present payload
          end case)
      end case) = value end for all
  end definition
end law

law "|Either patterns preserve their constructor| is
  definition :
    for all (value :: Either (List Int8) (Maybe Bool)) =>
      (first matching case of value :
        when Left items then Left items
        when Right optional then Right optional
      end case) = value end for all
  end definition
end law

-- The annotation gives the empty-case literal the same primitive type as head.
law "|matching can provide a default value| is
  definition :
    for all (value :: Maybe Int8) =>
      ((first matching case of value :
        when Absent then 0
        when Present payload then payload
      end case) :: Int8) = ((first matching case of value :
        when Present payload then payload
        when Absent then 0
      end case) :: Int8) end for all
  end definition
end law
end unit
