unit example.keywords

-- A name that is a keyword of a target language is emitted there with a
-- leading underscore: short is _short in Java, lambda is _lambda in Python,
-- and class is _class wherever class is reserved. Other targets keep the name.

function short (x :: Integer) -> Bool is x < 10 end function
function double (x :: Integer) -> Integer is x + x end function
function lambda (x :: Integer) -> Integer is x + 1 end function
function fun (x :: Integer) -> Integer is x + 2 end function
function loop (x :: Integer) -> Integer is x + 3 end function
function deriving (x :: Integer) -> Integer is x + 4 end function
function delete (x :: Integer) -> Integer is x + 5 end function

-- An adapter, written by hand on each target as _class or class.
class :: Integer -> Integer

law "|keyword names are callable| is
  definition :
    for all (x :: Integer) =>
      double x - x + lambda x + fun x + loop x + deriving x + delete x = 6 * x + 15 end for all
  end definition
  example "|short| :
    x = 3
    expect short x = true
  end example
end law

law "|the class adapter doubles| is
  definition :
    for all (x :: Integer) => class x = double x end for all
  end definition
end law
end unit
