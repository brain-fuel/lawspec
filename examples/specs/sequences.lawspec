unit example.sequences

-- Text, Bytes and List are sequences: joined with ++, sliced, and read by
-- index. Bytes give their octets, and Text its UTF-8 encoding.

-- A record key's hash: FNV-1a over the key's octets, in 32 bits.
function fnv (octets :: List UInt8) (hash :: UInt32) -> UInt32 is
  first matching case of octets :
  when Nil then hash
  when Cons o rest then fnv rest (prelude.wrapping ((xorByte hash o) * 16777619))
  end case
end function

-- hash xor o, for an octet o, by its low eight bits.
function xorByte (hash :: UInt32) (o :: UInt8) -> Integer is
  let low = prelude.rem hash 256 in
  hash - low + xorBits low o 128 end let
end function

function xorBits (a :: Integer) (b :: Integer) (bit :: Integer) -> Integer is
  if bit <= 0 || a < 0 || b < 0 then 0 else
    (if prelude.quot a bit != prelude.quot b bit then bit else 0 end if)
      + xorBits (prelude.rem a bit) (prelude.rem b bit) (prelude.quot bit 2) end if
end function

function keyHash (key :: Bytes) -> UInt32 is fnv (prelude.octets key) 2166136261 end function

function partitionFor (key :: Bytes) (n :: Int32) -> Int32 is
  if n >= 1 then prelude.Int32 (prelude.rem (keyHash key) n) else 0 end if
end function

law "|a key's partition exists| is
  definition :
    for all (key :: Bytes) (n :: Int32 where n >= 1 && n <= 64) =>
      (partitionFor key n >= 0 && partitionFor key n < n) = true end for all
  end definition
end law

law "|the hash follows FNV-1a| is
  definition : keyHash (prelude.utf8 "a") = 3826002220 and keyHash (prelude.utf8 "") = 2166136261 end definition
end law

-- Member ids, made by the coordinator from a client id and a counter.
function memberId (client :: Text) (n :: Int32) -> Text is client ++ "-" ++ prelude.textOf n end function

law "|a member id starts with its client| is
  definition :
    for all (client :: Text) (n :: Int32) => memberId client n starts with client end for all
  end definition
  example "|the third| :
    client = "consumer"
    n = 3
    expect memberId client n = "consumer-3"
  end example
end law

law "|joining text adds lengths| is
  definition :
    for all (a :: Text) (b :: Text) => prelude.length (a ++ b) = prelude.length a + prelude.length b end for all
  end definition
end law

law "|octets and bytes round trip| is
  definition : for all (b :: Bytes) => prelude.bytesOf (prelude.octets b) = b end for all end definition
end law

law "|a slice is a part| is
  definition :
    for all (xs :: List Int32) (k :: Int32 where k >= 0 && k <= 10) =>
      prelude.take k xs ++ prelude.drop k xs = xs end for all
  end definition
end law

law "|at reads the item an index names| is
  definition :
    for all (x :: Int32) (xs :: List Int32) => prelude.at 0 (Cons x xs) = Just x and prelude.at (prelude.length xs + 1) (Cons x xs) = Nothing end for all
  end definition
end law

law "|texts join with a separator| is
  definition : prelude.join ", " ["a", "b", "c"] = "a, b, c" and prelude.slice 1 3 "kafka" = "af" end definition
end law

law "|utf8 encodes code points| is
  definition : prelude.utf8 "é" = prelude.bytesOf [195, 169] and prelude.length (prelude.utf8 "é") = 2 end definition
end law
end unit
