unit example.workflows

-- Workflows compose steps written by hand on each target. LawSpec generates
-- the composition itself, so a workflow behaves the same everywhere: every
-- stage below is a keyword, and each has a symbol too (>>=, <$>, <!>, <|>, ??).

type Signup is a record{  name :: Text age :: Int32} end type
type Account is a record{  name :: Text age :: Int32 level :: Int32} end type
type SignupError is one of | MissingName | TooYoung | NameTooLong | Unavailable end type

-- Checked definitions: LawSpec writes these on every target.
function explain (reason :: Text) -> SignupError is TooYoung end function

function promote (a :: Account) -> Account is
  first matching case of a :
  when Account record{ name = name , age = age , level = level} then Account record{ name = name , age = age , level = 2}
  end case
end function

function brief (a :: Account) -> Bool is
  first matching case of a :
  when Account record{ name = name , age = age , level = level} then prelude.length name <= 8
  end case
end function

function tooLong (a :: Account) -> SignupError is NameTooLong end function

function nameOf (s :: Signup) -> Text is
  first matching case of s :
  when Signup record{ name = name , age = age} then name
  end case
end function

-- Side steps and recovery handlers, also written by hand.
audit :: Account -> Bool
waitlist :: SignupError -> Either SignupError Account

-- The workflow's error type is declared, so every step must fail with
-- SignupError; checkAge fails with a reason, which mapError turns into one.
workflow register :: Signup -> Either SignupError Account is
  checkName :: Signup -> Either SignupError Signup
    retry exponential 100ms 2 3 max 1s jitter full
  then checkAge :: Signup -> Either Text Signup
  mapError explain
  then openAccount :: Signup -> Either SignupError Account
  map promote
  tap audit
  ensure brief else tooLong
  orElse waitlist
end workflow

-- With the error written as _, LawSpec generates GreetError, with one
-- constructor per step that can fail: GreetCheckNameFailed and GreetCheckAgeFailed.
workflow greet :: Signup -> Either _ Text is
  checkName :: Signup -> Either SignupError Signup
  >>= checkAge :: Signup -> Either Text Signup
  <$> nameOf
  ?? anonymous
end workflow

function anonymous (e :: GreetError) -> Text is "guest" end function

law "|registering an account| is
  definition :
    for all (s :: Signup) =>
      prelude.isRight (register s) = (first matching case of s :
        when Signup record{ name = name , age = age} then
            prelude.length name > 0 && age >= 18 && prelude.length name <= 8
        end case) end for all
  end definition
  example "|a new account is promoted| :
    s = Signup record{ name = "ada" , age = 30}
    expect register s = Right (Account record{ name = "ada" , age = 30 , level = 2})
  end example
  example "|a name is required| :
    s = Signup record{ name = "" , age = 30}
    expect register s = Left MissingName
  end example
  example "|seventeen is too young| :
    s = Signup record{ name = "bob" , age = 17}
    expect register s = Left TooYoung
  end example
  example "|a long name is rejected| :
    s = Signup record{ name = "bartholomew" , age = 30}
    expect register s = Left NameTooLong
  end example
  example "|a taken name joins the waitlist| :
    s = Signup record{ name = "taken" , age = 30}
    expect register s = Right (Account record{ name = "waitlist" , age = 18 , level = 0})
  end example
end law

law "|greeting never fails| is
  definition :
    for all (s :: Signup) => prelude.isRight (greet s) = true end for all
  end definition
  example "|a named greeting| :
    s = Signup record{ name = "ada" , age = 30}
    expect greet s = Right "ada"
  end example
  example "|an anonymous greeting| :
    s = Signup record{ name = "" , age = 30}
    expect greet s = Right "guest"
  end example
end law

-- An all group runs its steps on the same state and combines their results.
-- With accumulate, every failing step's error is reported, in a generated
-- VetFailures constructor.
function firstName (a :: Signup) (b :: Signup) -> Text is nameOf a end function

workflow vet :: Signup -> Either _ Text is
  all accumulate
    then checkName
    then checkAge
  end all
  combine firstName
end workflow

law "|vetting reports every problem| is
  definition :
    for all (s :: Signup) =>
      prelude.isRight (vet s) = (first matching case of s :
        when Signup record{ name = name , age = age} then prelude.length name > 0 && age >= 18
        end case) end for all
  end definition
  example "|no problems| :
    s = Signup record{ name = "ada" , age = 30}
    expect vet s = Right "ada"
  end example
end law

law "|vetting a nameless child reports both problems| is
  definition :
    for all (age :: Int8 where age >= 0 && age < 18) =>
      vet (Signup record{ name = "" , age = (prelude.Int32 age)}) = Left (VetFailures [VetCheckNameFailed MissingName, VetCheckAgeFailed "too young"]) end for all
  end definition
end law

law "|vetting a named child reports its age| is
  definition :
    for all (age :: Int8 where age >= 0 && age < 18) =>
      vet (Signup record{ name = "ada" , age = (prelude.Int32 age)}) = Left (VetFailures [VetCheckAgeFailed "too young"]) end for all
  end definition
end law

-- In a workflow with asynchronous steps, an all group runs them at the same
-- time. Order -1's checks are slow: the stock check takes 400ms and the
-- credit check 250ms, so run in turn they would take 650ms. Every order with
-- a negative number fails both checks.
type Order is a record{  number :: Int64} end type

async checkStock :: Order -> Either Text Order
async checkCredit :: Order -> Either Text Order

function firstOrder (a :: Order) (b :: Order) -> Order is a end function

workflow approve :: Order -> Either _ Order is
  all accumulate
    then checkStock
    then checkCredit
  end all
  combine firstOrder
end workflow

-- The failures are in the order the steps are declared, not the order they
-- finish in.
law "|approval reports failures in declaration order| is
  definition :
    for all (n :: Int64) =>
      approve (Order record{ number = n}) = prelude.select (n < 0)
        (Left (ApproveFailures [ApproveCheckStockFailed "no stock", ApproveCheckCreditFailed "no credit"]))
        (Right (Order record{ number = n})) end for all
  end definition
end law
end unit
