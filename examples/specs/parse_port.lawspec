unit example.parse_port

validPort :: Int32 -> Bool
render    :: Int32 -> Text
parse     :: Text -> Int32

law "|valid ports round trip| is
  definition :
    for all (x :: Int32) =>
      validPort x implies
        parse (render x) = x end for all
  end definition

  description :
    "For ports in 1 through 65535, {parse} recovers the value written by {render}"
  end description

  example "|ordinary port| :
    x = 443
    expect validPort x = true
    expect render x = "443"
    expect parse (render x) = 443
  end example

  example "|lowest port is accepted and round trips| :
    x = 1
    expect validPort x = true
    expect render x = "1"
    expect parse (render x) = 1
  end example

  example "|highest port is accepted and round trips| :
    x = 65535
    expect validPort x = true
    expect render x = "65535"
    expect parse (render x) = 65535
  end example

  example "|zero is rejected; rendering and parsing are skipped| :
    x = 0
    expect validPort x = false
  end example

  example "|negative port is rejected; rendering and parsing are skipped| :
    x = -1
    expect validPort x = false
  end example

  example "|65536 is rejected; rendering and parsing are skipped| :
    x = 65536
    expect validPort x = false
  end example
end law

law "|the same port contract via the prelude| is
  definition :
    apply law "|left inverse when| validPort parse render
  end definition

  example "|port 8080 satisfies the inherited condition and round trips| :
    x = 8080
    expect validPort x = true
    expect render x = "8080"
    expect parse (render x) = 8080
  end example
end law
end unit
