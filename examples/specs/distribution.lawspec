unit example.distribution

-- Distribution. Nodes reach each other's actors, channels and checked
-- definitions over a transport: in memory (with faults, for testing), TCP or
-- HTTP. Values cross in the canonical wire encoding, the same bytes on every
-- target, so a node on one target can talk to a node on another.

-- The wire encoding's conformance vectors: values generated from a type
-- descriptor and a seed, then encoded, in hexadecimal.
encoded :: Text -> UInt64 -> Int32 -> Int32 -> List Text
roundTrips :: Text -> UInt64 -> Int32 -> Int32 -> Bool

law `integers on the wire` is
  definition is
    `for all` (seed :: UInt64) . prelude.length (encoded "(int Integer _ _)" seed 4 4) = 4
  end
  example `seed 7` is
    seed = 7
    expect encoded "(int Integer _ _)" seed 4 4 = ["9ddc4f", "eefb17", "8fc703", "8ee709"]
    expect encoded "(int Int8 -128 127)" 42 4 5 = ["f901", "28", "00", "48", "5c"]
  end
end

law `text, lists, Maybe and Either on the wire` is
  definition is
    `for all` (seed :: UInt64) . roundTrips "(list (maybe (either (int UInt8 0 255) (text))))" seed 4 8 = true
  end
  example `vectors` is
    seed = 3
    expect encoded "(text)" seed 4 3 = ["037b5b2c", "0134", "024d54"]
    expect encoded "(list (maybe (bool)))" 5 3 3 = ["02000101", "0100", "010100"]
    expect encoded "(either (int UInt8 0 255) (text))" 9 3 4 = ["00ec02", "0000", "00d201", "0100"]
  end
end

law `data types on the wire` is
  definition is
    `for all` (seed :: UInt64) . roundTrips "(data Shape (ctor Shape::Circle (int Int32 0 100)) (ctor Shape::Box (int Int32 0 100) (int Int32 0 100)) (ctor Shape::Group (list (ref Shape))))" seed 4 8 = true
  end
  example `vectors` is
    seed = 11
    expect encoded "(data Shape (ctor Shape::Circle (int Int32 0 100)) (ctor Shape::Box (int Int32 0 100) (int Int32 0 100)) (ctor Shape::Group (list (ref Shape))))" seed 3 3 = ["0030", "020201b80100015ac801", "014808"]
  end
end

-- A checked definition that another node evaluates by its content hash.
definition shifted (x :: Int32) :: Int64 is x + 1000 end

-- Calls that cross a network wait for it, so they are asynchronous.
async remoteShifted :: Int32 -> Int64

law `a definition evaluated on another node` is
  definition is `for all` (x :: Int32) . remoteShifted x = shifted x end
end

-- An actor served on one node and called from another.
type Tally is Tally count :: Int64 end

openTally :: Unit -> Tally
add :: Tally -> UInt8 -> Pair Int64 Tally

definition modelAdd (n :: UInt8) (total :: Int64 where total >= 0 && total <= 1000000) :: Pair Int64 Int64 is
  Pair (total + n) (total + n)
end

actor tally :: Tally by Int64 is
  start openTally by 0
  on add by modelAdd
end

async remoteAdds :: UInt8 -> Int64

law `two calls from another node` is
  definition is `for all` (x :: UInt8) . remoteAdds x = 2 * x end
end

-- A protocol between two nodes: the first end sends a number and receives
-- its double.
protocol Doubling is
  send Int32
  receive Int64
end

async remoteDoubling :: Int32 -> Int64

law `a conversation between nodes` is
  definition is `for all` (x :: Int32) . remoteDoubling x = 2 * x end
end

-- A mailbox offered on one node and sent to from another: each send waits
-- until the mailbox has the message.
mailbox ledger of Int64

async remoteLedger :: Int32 -> Int64

law `messages reach a mailbox on another node` is
  definition is `for all` (x :: Int32) . remoteLedger x = 2 * x end
end

-- A channel end sent to another node. A local end stays where it is and
-- the sending node relays its conversation, so the end works on its new
-- node as it did on the old one.
protocol Handoff is
  send Doubling
end

async remoteHandoff :: Int32 -> Int64

law `a channel end handed to another node` is
  definition is `for all` (x :: Int32) . remoteHandoff x = 2 * x end
end

-- An end that is already between nodes moves: its state goes to the new
-- node, with any values that reached it, and its peer is told the new
-- address. Here an end whose peer is on node C goes from A to B and on to D
-- over a network that loses, duplicates and delays frames, while C is
-- already sending to it; then A and B close, and the conversation between C
-- and D still completes.
protocol Answering is
  receive Int32
  send Int64
end

protocol Passing is
  send Answering
end

async remoteHandoffOnward :: Int32 -> Int64

law `a channel end moved on twice` is
  definition is `for all` (x :: Int32) . remoteHandoffOnward x = 2 * x end
end

-- The network is secure by default. Each node has an ML-DSA-65 identity;
-- the first frame between two nodes waits for a handshake (a signed
-- ML-KEM-768 exchange), and every frame then crosses sealed with
-- AES-256-GCM. A node on the in-memory transport made for tests can skip
-- it; no other transport can.
async sealedOnTheWire :: Int32 -> Bool

law `frames cross sealed by default` is
  definition is `for all` (x :: Int32) . sealedOnTheWire x = true end
end

-- Every target computes the same handshake: from these seeds and this
-- ciphertext, the same hashes of the hello and welcome, the same session
-- key, and the same sealed frame. The fields are, in order: the two
-- identities' seeds, the ephemeral ML-KEM seed, the session, the two
-- addresses, the ciphertext, the nonce, the frame, then the expected hashes,
-- key and sealed record (dev/handshake-vector.py makes them).
handshakeAgrees :: Text -> Bool

law `the secure handshake agrees across targets` is
  definition is handshakeAgrees "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f 202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f 404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f 808182838485868788898a8b8c8d8e8f tcp://10.0.0.1:7000 tcp://10.0.0.2:7000  c8c9cacbcccdcecfd0d1d2d3 046368616e05656e642d33137463703a2f2f31302e302e302e313a373030300e0300022a da31284386e2b951348bda30557cf4b5abb4ad9a1ac15582e99c3b938573a254 9c78ba836e9dcaf2845dceaa7a02c9aad0fe0fd29bb9a5b948635c65aa4b2676 c595a58a85aebe6fb8009a0ca6afc9eb614c7ab4711c08c4f7d34c38420c4abd 4c53010310808182838485868788898a8b8c8d8e8f0040c8c9cacbcccdcecfd0d1d2d314713b317e0cd4b10f4d5b885bc8bc1fa7aae4f824a30442ed569d3eab22fcce44c274bd139e84e8a9960d14a17722544ee187c1" = true end
end
