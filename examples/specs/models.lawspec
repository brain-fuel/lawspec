unit example.models

-- A stateful model pairs a system's commands with reference definitions over
-- a simpler model state. LawSpec generates runs of commands, runs them
-- against the adapters, and checks each result and state against the model.

-- A linear model: the stack's size is in its type, so a run never pops an
-- empty stack.
type Stack (n :: Whole) is one of
  | Empty where n = 0
  | Push of type record{ top :: Int8 rest :: Stack m} where n = m + 1
end type

empty :: Unit -> Stack 0
push :: (x :: Int8) -> Stack n / Stack (n + 1) -> Unit
pop :: Stack (n + 1) / Stack n -> Int8
peek :: Stack (n + 1) / Stack (n + 1) -> Int8

function modelPush (x :: Int8) (xs :: List Int8) -> List Int8 is Cons x xs end function

function modelPop (xs :: List Int8) -> Pair Int8 (List Int8) is
  first matching case of xs :
  when Nil then Pair 0 Nil
  when Cons x rest then Pair x rest
  end case
end function

function modelPeek (xs :: List Int8) -> Pair Int8 (List Int8) is
  first matching case of xs :
  when Nil then Pair 0 Nil
  when Cons x rest then Pair x xs
  end case
end function

function toList (s :: Stack n) -> List Int8 is
  first matching case of s :
  when Empty then Nil
  when Push record{ top = top , rest = rest} then Cons top (toList rest)
  end case
end function

model stack :: Stack n by List Int8 is
  start empty by Nil
  push by modelPush
  pop by modelPop
  peek by modelPeek
  abstract toList
end model

-- A shared model: commands take one counter, whose type never changes, and
-- may run at the same time, so each must be atomic. LawSpec also runs them
-- in parallel and checks that every history is linearizable.
type Counter is a record{  id :: Int32} end type

newCounter :: Unit -> Counter
async increment :: Counter -> Int64
async decrement :: Counter -> Int64
async read :: Counter -> Int64

function modelIncrement (n :: Int64 where n >= 0 && n <= 1000000) -> Pair Int64 Int64 is Pair (n + 1) (n + 1) end function
function modelDecrement (n :: Int64 where n >= 0 && n <= 1000000) -> Pair Int64 Int64 is Pair (n - 1) (n - 1) end function
function modelRead (n :: Int64) -> Pair Int64 Int64 is Pair n n end function
function positive (n :: Int64) -> Bool is n > 0 end function

model counter :: shared Counter by Int64 is
  start newCounter ~ 0
  increment ~ modelIncrement
  decrement ~ modelDecrement when positive
  read ~ modelRead
end model

-- A protocol lists what one end of a channel sends and receives; the other
-- end does the reverse. Scenarios run a shared model's commands from
-- processes that run at the same time and talk over channels; LawSpec checks
-- that they cannot deadlock or race, then runs them on many schedules, and
-- each run must agree with the model.
protocol Report is
  send Int64
end protocol

protocol Request is
  send Report
end protocol

scenario `a count is passed on` in counter is
  channel report :: Report
  par
    n <- increment
    send report n
  with
    receive report m
    expect m = 1
  end par
end scenario

-- The asker hands its end of the answer channel to a worker, which replies
-- to the listener directly.
scenario `a reply is delegated` in counter is
  channel ask :: Request
  channel answer :: Report
  par
    send ask answer
  with
    receive ask reply
    n <- increment
    send reply n
  with
    receive answer m
    expect m = 1
  end par
end scenario

scenario `two counts at once` in counter is
  par
    a <- increment
  with
    b <- increment
  end par
  total <- read
  expect total = 2
end scenario

-- Two channels between the same two processes close a cycle. That is
-- accepted when no process waits for another in a cycle: here the first
-- process sends before it waits, so the echo can always answer.
protocol Echo is
  receive Int64
end protocol

scenario `a count is echoed back` in counter is
  channel out :: Report
  channel back :: Echo
  par
    n <- increment
    send out n
    receive back m
    expect m = 1
  with
    receive out k
    send back k
  end par
end scenario
end unit
