unit example.generation

-- Conformance of every target's portable generator with the same vectors:
-- the values generated from a type descriptor and a SplitMix64 seed, and the
-- shrink candidates of the first, rendered canonically.

generated :: Text -> UInt64 -> Int32 -> Int32 -> List Text
shrunk :: Text -> UInt64 -> Int32 -> List Text

law "|int8| is
  definition :
    for all (seed :: UInt64) => prelude.length (generated "(int Int8 -128 127)" seed 4 5) = 5 end for all
  end definition
  example "|seed 42| :
    seed = 42
    expect generated "(int Int8 -128 127)" seed 4 5 = ["-125", "20", "0", "36", "46"]
    expect shrunk "(int Int8 -128 127)" seed 4 = ["0", "-63", "-124"]
  end example
end law

law "|unbounded integers| is
  definition :
    for all (seed :: UInt64) => prelude.length (generated "(int Integer _ _)" seed 4 4) = 4 end for all
  end definition
  example "|seed 7| :
    seed = 7
    expect generated "(int Integer _ _)" seed 4 4 = ["-653071", "196343", "-29128", "80327"]
    expect shrunk "(int Integer _ _)" seed 4 = ["0", "-326536", "-653070"]
  end example
end law

law "|a lower bound| is
  definition :
    for all (seed :: UInt64) => prelude.length (generated "(int Int32 5 _)" seed 4 4) = 4 end for all
  end definition
  example "|seed 7| :
    seed = 7
    expect generated "(int Int32 5 _)" seed 4 4 = ["346934", "1196348", "970877", "1080332"]
    expect shrunk "(int Int32 5 _)" seed 4 = ["5", "173470", "346933"]
  end example
end law

law "|the full UInt64 range| is
  definition :
    for all (seed :: UInt64) => prelude.length (generated "(int UInt64 0 18446744073709551615)" seed 4 3) = 3 end for all
  end definition
  example "|seed 1| :
    seed = 1
    expect generated "(int UInt64 0 18446744073709551615)" seed 4 3 = ["13757245211066428519", "1", "0"]
    expect shrunk "(int UInt64 0 18446744073709551615)" seed 4 = ["0", "6878622605533214260", "13757245211066428518"]
  end example
end law

law "|booleans| is
  definition :
    for all (seed :: UInt64) => prelude.length (generated "(bool)" seed 4 6) = 6 end for all
  end definition
  example "|seed 3| :
    seed = 3
    expect generated "(bool)" seed 4 6 = ["true", "true", "true", "true", "false", "true"]
    expect shrunk "(bool)" seed 4 = ["false"]
  end example
end law

law "|text| is
  definition :
    for all (seed :: UInt64) => prelude.length (generated "(text)" seed 6 3) = 3 end for all
  end definition
  example "|seed 9| :
    seed = 9
    expect generated "(text)" seed 6 3 = ["\"I(\"", "\"\"", "\"4<*6F\""]
    expect shrunk "(text)" seed 6 = ["\"\"", "\"I\"", "\"(\""]
  end example
end law

law "|unit| is
  definition :
    for all (seed :: UInt64) => prelude.length (generated "(unit)" seed 1 2) = 2 end for all
  end definition
  example "|seed 1| :
    seed = 1
    expect generated "(unit)" seed 1 2 = ["()", "()"]
    expect shrunk "(unit)" seed 1 = []
  end example
end law

law "|lists| is
  definition :
    for all (seed :: UInt64) => prelude.length (generated "(list (int Int32 0 _))" seed 4 3) = 3 end for all
  end definition
  example "|seed 42| :
    seed = 42
    expect generated "(list (int Int32 0 _))" seed 4 3 = ["[0, 1745563, 275752]", "[1325093, 742426, 493279]", "[2000000]"]
    expect shrunk "(list (int Int32 0 _))" seed 4 = ["[]", "[0]", "[1745563, 275752]", "[0, 275752]", "[0, 1745563]", "[0, 0, 275752]", "[0, 872782, 275752]", "[0, 1745562, 275752]", "[0, 1745563, 0]", "[0, 1745563, 137876]", "[0, 1745563, 275751]"]
  end example
end law

law "|maybe| is
  definition :
    for all (seed :: UInt64) => prelude.length (generated "(maybe (bool))" seed 4 4) = 4 end for all
  end definition
  example "|seed 5| :
    seed = 5
    expect generated "(maybe (bool))" seed 4 4 = ["Present(false)", "Present(true)", "Present(false)", "Present(true)"]
    expect shrunk "(maybe (bool))" seed 4 = ["Absent"]
  end example
end law

law "|either| is
  definition :
    for all (seed :: UInt64) => prelude.length (generated "(either (text) (int Int8 -128 127))" seed 4 4) = 4 end for all
  end definition
  example "|seed 11| :
    seed = 11
    expect generated "(either (text) (int Int8 -128 127))" seed 4 4 = ["Right(-19)", "Left(\"\\\"{U\")", "Left(\"j\")", "Right(1)"]
    expect shrunk "(either (text) (int Int8 -128 127))" seed 4 = ["Right(0)", "Right(-10)", "Right(-18)"]
  end example
end law

law "|a recursive tree| is
  definition :
    for all (seed :: UInt64) => prelude.length (generated "(data Tree (ctor t::type::Tree::Leaf) (ctor t::type::Tree::Node (ref Tree) (int Int8 -128 127) (ref Tree))) (ref Tree)" seed 3 2) = 2 end for all
  end definition
  example "|seed 13| :
    seed = 13
    expect generated "(data Tree (ctor t::type::Tree::Leaf) (ctor t::type::Tree::Node (ref Tree) (int Int8 -128 127) (ref Tree))) (ref Tree)" seed 3 2 = ["Node(Node(Leaf, -29, Leaf), -44, Node(Node(Leaf, -110, Leaf), 58, Leaf))", "Leaf"]
    expect shrunk "(data Tree (ctor t::type::Tree::Leaf) (ctor t::type::Tree::Node (ref Tree) (int Int8 -128 127) (ref Tree))) (ref Tree)" seed 3 = ["Leaf", "Node(Leaf, -29, Leaf)", "Node(Node(Leaf, -110, Leaf), 58, Leaf)", "Node(Leaf, -44, Node(Node(Leaf, -110, Leaf), 58, Leaf))", "Node(Node(Leaf, 0, Leaf), -44, Node(Node(Leaf, -110, Leaf), 58, Leaf))", "Node(Node(Leaf, -15, Leaf), -44, Node(Node(Leaf, -110, Leaf), 58, Leaf))", "Node(Node(Leaf, -28, Leaf), -44, Node(Node(Leaf, -110, Leaf), 58, Leaf))", "Node(Node(Leaf, -29, Leaf), 0, Node(Node(Leaf, -110, Leaf), 58, Leaf))", "Node(Node(Leaf, -29, Leaf), -22, Node(Node(Leaf, -110, Leaf), 58, Leaf))", "Node(Node(Leaf, -29, Leaf), -43, Node(Node(Leaf, -110, Leaf), 58, Leaf))", "Node(Node(Leaf, -29, Leaf), -44, Leaf)", "Node(Node(Leaf, -29, Leaf), -44, Node(Leaf, -110, Leaf))", "Node(Node(Leaf, -29, Leaf), -44, Node(Leaf, 58, Leaf))", "Node(Node(Leaf, -29, Leaf), -44, Node(Node(Leaf, 0, Leaf), 58, Leaf))", "Node(Node(Leaf, -29, Leaf), -44, Node(Node(Leaf, -55, Leaf), 58, Leaf))", "Node(Node(Leaf, -29, Leaf), -44, Node(Node(Leaf, -109, Leaf), 58, Leaf))", "Node(Node(Leaf, -29, Leaf), -44, Node(Node(Leaf, -110, Leaf), 0, Leaf))", "Node(Node(Leaf, -29, Leaf), -44, Node(Node(Leaf, -110, Leaf), 29, Leaf))", "Node(Node(Leaf, -29, Leaf), -44, Node(Node(Leaf, -110, Leaf), 57, Leaf))"]
  end example
end law

-- A refinement's bounds narrow generation: an amount from 1 to 1000 is
-- drawn from that range, not filtered out of every Int32, alongside a value
-- of a data type.
type Purse is a record{  coins :: Int64} end type

function spend (p :: Purse) (amount :: Int32 where amount >= 1 && amount <= 1000) -> Int32 is amount end function

law "|refined amounts are drawn from their range| is
  definition :
    for all (p :: Purse) (amount :: Int32 where amount >= 1 && amount <= 1000) => spend p amount >= 1 end for all
  end definition
end law

-- if c then a else b evaluates only the branch c selects, and each branch is
-- checked knowing which way c went: the division is safe because n > 0.
function share (total :: Int32 where total >= 0 && total <= 1000) (n :: Int32 where n >= 0 && n <= 10) -> Int32 is
  if n > 0 then prelude.quot total n else 0 end if
end function

law "|a share is at most the total| is
  definition :
    for all (t :: Int32 where t >= 0 && t <= 1000) (n :: Int32 where n >= 0 && n <= 10) => share t n <= t end for all
  end definition
  example "|nobody to share with| :
    t = 7
    n = 0
    expect share t n = 0
  end example
  example "|three people| :
    t = 7
    n = 3
    expect share t n = 2
  end example
end law

-- A text refined to be non-empty is drawn from its refinement, at every
-- size: four of them, one also unlike another, are met at the first case,
-- not filtered out of draws that are mostly empty while the size is small.
law "|several non-empty texts are drawn| is
  definition :
    for all (a :: Text where a != "") (b :: Text where b != "") (c :: Text where c != "")
      (d :: Text where d != "" && d != c) =>
      prelude.length a + prelude.length b + prelude.length c + prelude.length d >= 4 end for all
  end definition
end law
end unit
