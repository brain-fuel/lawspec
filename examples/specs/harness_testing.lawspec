-- The harness of example.harness: how its laws are tested. A harness
-- cannot change what a law means; it chooses inputs, handlers, adequacy and
-- how the tests run.
harness example.harness.testing for example.harness is
  -- Small orders: up to three items at a dollar each.
  strategy smallOrder :: Order is
    bind items :: Int32 from (one of 0, 1, 2, 3) in one of Order record{ items = items , total = (items * 100)} end bind
  end strategy
  -- Bulk orders: the default generator, kept to large ones.
  strategy bulkOrder :: Order is
    any such that itemsOf it > 10 && totalOf it >= 0 at most 1000 discards
  end strategy
  strategy orders :: Order is frequency 9 smallOrder, 1 bulkOrder end strategy

  tags pricing
  test with fakeLedger
  order random
  parallel

  for law "|a discount is never more than the total|
    use orders for order
    cover 5% "empty order" when isEmpty order
    classify totalOf order > 1000 as "large"
    label if isEmpty order then "empty" else "some items" end if
    timeout 10 s
  end for law

  for law "|rounding is idempotent|
    target maximize cents
    repeat 2
    retry flaky 1

  end for law
  for law "|rounding never lowers a price|
    known discrepancy "rounds half down; see PRICE-12"

  end for law
  for law "|a refund is never booked twice|
    skip "refunds are not booked yet"

  end for law
  for laws "|booking a positive amount succeeds|, "|positive amounts are accepted|
    tags ledger

  end for laws
  share Scratch per unit
  benchmark `discount of a bulk order` is discount (Order record{ items = 30 , total = 50000}) end benchmark
  -- book uses Ledger: the benchmark runs under its production handler.
  benchmark `booking a payment` is book 500 end benchmark
end harness
