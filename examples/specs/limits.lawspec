unit example.limits

-- A workflow with a rate limit, for the resilience suite: two calls per
-- second, rejecting the rest. Its own unit, so the suite's checks can call it
-- on every target (a Haskell workflow imports its steps' module).
type Ticket is Ticket number :: Int64 end

admitTicket :: Ticket -> Either Text Ticket

workflow limited :: Ticket -> Either _ Ticket is
  admitTicket :: Ticket -> Either Text Ticket
    rateLimit tokenBucket 2 1s reject
end

-- A workflow that compensates: when charging fails, the reserved seat is
-- released.
reserveSeat :: Ticket -> Either Text Ticket
chargeCard :: Ticket -> Either Text Ticket
releaseSeat :: Ticket -> Bool

workflow book :: Ticket -> Either _ Ticket is
  reserveSeat :: Ticket -> Either Text Ticket
    compensate releaseSeat
  chargeCard :: Ticket -> Either Text Ticket
end

-- An asynchronous step within a timeout: the quote for ticket -1 is slow
-- (600ms), so its stage times out.
async fetchQuote :: Ticket -> Either Text Ticket

workflow quoted :: Ticket -> Either _ Ticket is
  fetchQuote :: Ticket -> Either Text Ticket
    timeout 200ms
end

-- An asynchronous step with a hedge: ticket -2's first quote stalls (600ms),
-- so a second starts after 50ms and answers first.
async hedgeQuote :: Ticket -> Either Text Ticket

workflow hedged :: Ticket -> Either _ Ticket is
  hedgeQuote :: Ticket -> Either Text Ticket
    hedge 50ms
end
