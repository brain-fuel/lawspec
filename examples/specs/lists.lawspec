unit example.lists

reverse :: List Int32 -> List Int32
sort :: List Int32 -> List Int32
sorted :: List Int32 -> Bool
permutation :: List Int32 -> List Int32 -> Bool
echoMaybe :: Maybe (Maybe Bool) -> Maybe (Maybe Bool)
echoEither :: Either (List Int32) (Maybe Bool) -> Either (List Int32) (Maybe Bool)
echoNested :: List (Maybe (Either CodeUnit16 Bytes)) -> List (Maybe (Either CodeUnit16 Bytes))

law `list involution` (f :: List a -> List a) requires Eq a is
  definition is `involution` f end
end

law `reverse twice restores the list` is
  definition is `list involution` reverse end
  example `ordered input` is
    x = [3, 1, 2]
    expect reverse x = [2, 1, 3]
  end
  example `empty input` is x = [] expect reverse x = [] end
end

law `sorting is idempotent` is
  definition is `idempotent` sort end
  example `duplicates` is x = [3, 1, 3] expect sort x = [1, 3, 3] end
end

law `sort produces sorted output` is
  definition is `for all` (xs :: List Int32) . sorted (sort xs) end
end

law `sort preserves length` is
  definition is `for all` (xs :: List Int32) . prelude.length (sort xs) = prelude.length xs end
end

law `sort preserves elements` is
  definition is `for all` (xs :: List Int32) . permutation (sort xs) xs end
end

law `nonempty reversal preserves length` is
  definition is
    `for all` (xs :: List Int32 where prelude.length xs > 0) .
      prelude.length (reverse xs) = prelude.length xs
  end
end

law `Maybe preserves nested absence` is
  definition is `for all` (x :: Maybe (Maybe Bool)) . echoMaybe x = x end
  example `outer absence` is x = Nothing expect echoMaybe x = Nothing end
  example `inner absence` is x = Just Nothing expect echoMaybe x = Just Nothing end
  example `present` is x = Just (Just true) expect echoMaybe x = Just (Just true) end
end

law `Either preserves branches` is
  definition is `for all` (x :: Either (List Int32) (Maybe Bool)) . echoEither x = x end
  example `left list` is x = Left [3, 1, 3] expect echoEither x = Left [3, 1, 3] end
  example `right absence` is x = Right Nothing expect echoEither x = Right Nothing end
end

law `nested raw values survive` is
  definition is `for all` (xs :: List (Maybe (Either CodeUnit16 Bytes))) . echoNested xs = xs end
  example `surrogate and octets` is
    xs = [Nothing, Just (Left codeUnit16(55296)), Just (Right bytes([0, 255]))]
    expect echoNested xs = [Nothing, Just (Left codeUnit16(55296)), Just (Right bytes([0, 255]))]
  end
end
