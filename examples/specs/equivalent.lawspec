unit example.alternatives

render :: Int32 -> Text
referenceRender :: Int32 -> Text
clamp :: Int32 -> Int32
referenceClamp :: Int32 -> Int32

law `decimal renderers agree` is
  definition is
    `equivalent` render referenceRender
  end
  description is
    "{render} agrees with {referenceRender} on decimal formatting"
  end
  rationale is
    "changing the formatting implementation must preserve its result"
  end
  example `both renderers produce "-42"` is
    x = -42
    expect render x = "-42"
    expect referenceRender x = "-42"
  end
  example `both renderers produce "0"` is
    x = 0
    expect render x = "0"
    expect referenceRender x = "0"
  end
end

law `nonnegative clamps agree` is
  definition is
    `equivalent` clamp referenceClamp
  end
  description is
    "{clamp} agrees with {referenceClamp} when clamping negative inputs to zero"
  end
  example `both clamps return 0 for -2147483648` is
    x = -2147483648
    expect clamp x = 0
    expect referenceClamp x = 0
  end
  example `both clamps return 2147483647 for 2147483647` is
    x = 2147483647
    expect clamp x = 2147483647
    expect referenceClamp x = 2147483647
  end
end
