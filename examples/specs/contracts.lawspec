unit example.contracts

-- Shapes contract importers write: handlers whose clauses fail, handlers
-- over Bytes and Text, refined records, and handlers named like their
-- abilities.

type Refusal is | Negative | Empty end

definition bump (n :: Int64) (total :: Int64) :: Pair Int64 Int64 fails with Refusal is
  if n < 0 then raise Negative else
    if total > 1000000 || n > 1000000 then Pair total total else Pair (prelude.Int64 (total + n)) (prelude.Int64 (total + n))
end

-- A definition that may fail but does not.
definition peek (total :: Int64) :: Pair Int64 Int64 fails with Refusal is Pair total total end

ability Counter is
  add :: Int64 -> Int64 fails with Refusal
  current :: Int64 fails with Refusal
end

-- Named like its ability.
handler counter for Counter with state total :: Int64 start 0 is
  add by bump
  current by peek
end

-- A state with no typed form keeps this handler on the dynamic path.
type Scaled is Scaled count :: Int64 scale :: Float64 end

definition bumpScaled (n :: Int64) (s :: Scaled) :: Pair Int64 Scaled fails with Refusal is
  if n < 0 then raise Negative else
    if s.count > 1000000 || n > 1000000 then Pair s.count s else
      Pair (prelude.Int64 (s.count + n)) (s with count = prelude.Int64 (s.count + n))
end

definition peekScaled (s :: Scaled) :: Pair Int64 Scaled fails with Refusal is Pair s.count s end

handler scaledCounter for Counter with state s :: Scaled start Scaled 0 1.0 is
  add by bumpScaled
  current by peekScaled
end

-- Bytes and Text inside handler clauses, on both paths.
ability Codec is
  octetCount :: Text -> Int64
  label :: Text -> Int32 -> Text
end

handler codec for Codec is
  octetCount t is prelude.length (prelude.octets (prelude.utf8 t)) end
  label t n is prelude.join "-" [t, prelude.textOf n] ++ prelude.slice 0 0 t end
end

handler scaledCodec for Codec with state s :: Float64 start 1.0 is
  octetCount t is prelude.length (prelude.bytesOf (prelude.octets (prelude.utf8 t))) end
  label t n is prelude.take (prelude.length t + 9) (t ++ "-" ++ prelude.textOf n) end
end

-- A failed operation leaves the handler's state as it was, on the typed
-- path (counter) and the dynamic one (scaledCounter).
law `a refused add changes nothing` using counter is
  definition is
    `for all` (n :: Int64 where n >= 0 && n <= 1000) .
      (let refused = prelude.attempt (add (0 - 1)) in add n) = n
  end
end

law `a refused add changes nothing, dynamically` using scaledCounter is
  definition is
    `for all` (n :: Int64 where n >= 0 && n <= 1000) .
      (let refused = prelude.attempt (add (0 - 1)) in add n) = n
  end
end

law `a text's octets count its UTF-8 bytes` using codec is
  definition is octetCount "é" = 2 and octetCount "ab" = 2 end
end

law `a text's octets count its UTF-8 bytes, dynamically` using scaledCodec is
  definition is octetCount "é" = 2 and octetCount "ab" = 2 end
end

law `a label joins its parts` using codec is
  definition is label "member" 3 = "member-3" end
end

law `a label joins its parts, dynamically` using scaledCodec is
  definition is label "member" 3 = "member-3" end
end

-- Refined records.
type Pet is
  Pet
    id :: Maybe Int64
    name :: (v :: Text where v matches regex "[a-z]+")
end

definition validName (name :: Text) :: Bool is name matches regex "[a-z]+" end

type Badge is
  Badge
    label :: (v :: Text where validName v)
end

definition withId (body :: Pet) (key :: Int64) :: Pet is body with id = Just key end

definition validPet (p :: Pet) :: Bool is p.name matches regex "[a-z]{2,8}" end

law `an id is set by a record update` is
  definition is
    `for all` (p :: Pet where validPet p) (key :: Int64) . (withId p key).id = Just key and (withId p key).name = p.name
  end
end

law `a badge keeps its label` is
  definition is `for all` (t :: Badge) . validName t.label = true end
end
