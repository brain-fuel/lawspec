unit example.records

import example.records.inner as inner

-- Records: a type with one constructor has fields that code reads by name
-- (account.balance) and replaces by name (account with balance = 0).

type Account is a record{

    owner :: Text
    balance :: Int64
    holds :: List Int64}
end type

type Ledger is a record{

    account :: Account
    entries :: Int32}
end type

function deposit (a :: Account) (amount :: Int64 where amount >= 0 && amount <= 1000000) -> Account is
  if a.balance >= 0 && a.balance <= 1000000000 then a with balance = prelude.Int64 (a.balance + amount) else a end if
end function

function rename (l :: Ledger) (name :: Text) -> Ledger is
  l with account = (l.account with owner = name), entries = 0
end function

law "|a deposit adds to the balance| is
  definition :
    for all (owner :: Text) (start :: Int64 where start >= 0 && start <= 1000000000) (amount :: Int64 where amount >= 0 && amount <= 1000000) =>
      (deposit (Account record{ owner = owner , balance = start , holds = []}) amount).balance = start + amount end for all
  end definition
end law

law "|a deposit keeps the owner and holds| is
  definition :
    for all (a :: Account) (amount :: Int64 where amount >= 0 && amount <= 1000000) =>
      (deposit a amount).owner = a.owner and (deposit a amount).holds = a.holds end for all
  end definition
end law

law "|renaming reads back| is
  definition :
    for all (l :: Ledger) (name :: Text) => (rename l name).account.owner = name and (rename l name).entries = 0 end for all
  end definition
end law

-- A definition may fail without any ability, and another may attempt it.
type Refusal is one of | Overdrawn | Unfunded end type

procedure withdraw (a :: Account) (amount :: Int64) -> Account fails with Refusal is
  if amount < 0 then raise Unfunded else
    if amount > a.balance then raise Overdrawn else a with balance = prelude.Int64 (a.balance - amount) end if end if
end procedure

function settled (a :: Account) (amount :: Int64) -> Either Refusal Int64 is
  first matching case of prelude.attempt (withdraw a amount) :
  when Left refusal then Left refusal
  when Right after then Right after.balance
  end case
end function

law "|a withdrawal within the balance leaves the rest| is
  definition :
    for all (owner :: Text) (start :: Int64 where start >= 0) (amount :: Int64 where amount >= 0 && amount <= start) =>
      settled (Account record{ owner = owner , balance = start , holds = []}) amount = Right (prelude.Int64 (start - amount)) end for all
  end definition
end law

law "|a withdrawal beyond the balance is refused| is
  definition :
    for all (owner :: Text) (start :: Int64 where start >= 0 && start < 1000) (amount :: Int64 where amount >= 1000) =>
      settled (Account record{ owner = owner , balance = start , holds = []}) amount = Left Overdrawn and settled (Account record{ owner = owner , balance = start , holds = []}) (0 - amount) = Left Unfunded end for all
  end definition
end law

-- A refinement through a definition still guides generation: sample
-- names come from the pattern, so the law does not starve its filter.
function validOwner (name :: Text) -> Bool is
  prelude.length name = 9 && name matches regex "acct-[0-9]{4}"
end function

law "|a renamed ledger keeps a valid owner| is
  definition :
    for all (l :: Ledger) (name :: Text where validOwner name) => validOwner (rename l name).account.owner end for all
  end definition
end law

-- A literal takes its type from where it is used: 0 is an Int64 here.
function opening (a :: Maybe Account) -> Int64 is
  let start = (first matching case of a : when Nothing then 0 when Just account then account.balance end case) in
  if start < 0 then 0 else start end if end let
end function

law "|an absent account opens at zero| is
  definition : opening Nothing = 0 end definition
end law

-- Recursion on an integer that moves toward a bound is total.
function countdown (n :: Whole) -> List Whole is
  if n = 0 then [] else Cons n (countdown (n - 1)) end if
end function

function evensBelow (i :: Int32) (n :: Int32) -> List Int32 is
  if i >= n || i < 0 then [] else
    (if prelude.rem i 2 = 0 then Cons i (evensBelow (prelude.Int32 (i + 1)) n) else evensBelow (prelude.Int32 (i + 1)) n end if) end if
end function

law "|a countdown has n items| is
  definition : for all (n :: Whole where n <= 50) => prelude.length (countdown n) = n end for all end definition
end law

law "|the evens below n are half of the range| is
  definition :
    for all (n :: Int32 where n >= 0 && n <= 40) =>
      prelude.length (evensBelow 0 n) = prelude.quot (n + 1) 2 end for all
  end definition
end law

law "|range counts from the first up to the last| is
  definition :
    for all (n :: Int32 where n >= 0 && n <= 40) => prelude.length (prelude.range 0 n) = n end for all
  end definition
  example "|three| :
    n = 3
    expect prelude.range 0 n = [0, 1, 2]
  end example
end law

-- The prover keeps what guards say about calls, lengths and remainders.
function clip (xs :: List Int32) -> Int32 is
  if prelude.length xs <= 100 then prelude.Int32 (prelude.length xs) else 100 end if
end function

function owner (p :: Int32) (k :: Int32) -> Int32 is
  if k >= 1 && p >= 0 then prelude.Int32 (prelude.rem p k) else 0 end if
end function

law "|a clipped length is at most 100| is
  definition : for all (xs :: List Int32) => (clip xs <= 100 && clip xs >= 0) = true end for all end definition
end law

law "|an owner is one of the k| is
  definition :
    for all (p :: Int32 where p >= 0) (k :: Int32 where k >= 1 && k <= 64) => (owner p k >= 0 && owner p k < k) = true end for all
  end definition
end law

-- Arithmetic into a bounded type, by name.
function nextEpoch (e :: Int16) -> Int16 is prelude.wrapping (e + 1) end function
function topUp (level :: UInt8) -> UInt8 is prelude.saturating (level + 10) end function
function total (a :: Int32) (b :: Int32) -> Maybe Int32 is prelude.bounded (a + b) end function

law "|epochs wrap around| is
  definition :
    for all (e :: Int16) => nextEpoch e = (if e = Int16.max then Int16.min else prelude.Int16 (e + 1) end if) end for all
  end definition
end law

law "|a top up stops at the top| is
  definition :
    for all (level :: UInt8) => topUp level = (if level >= 245 then 255 else prelude.UInt8 (level + 10) end if) end for all
  end definition
end law

law "|a total that overflows is Nothing| is
  definition :
    for all (a :: Int32) (b :: Int32) =>
      total a b = (if a + b > Int32.max || a + b < Int32.min then Nothing else Just (prelude.Int32 (a + b)) end if) end for all
  end definition
end law

-- A refinement shapes generation: texts a regex must match are drawn from
-- the regex, through the definition that says so, not filtered from any
-- text.
function validTopic (name :: Text) -> Bool is
  let n = prelude.length name in
  n >= 1 && n <= 249 && name != "." && name != ".." && name matches regex "[a-zA-Z0-9._-]+" end let
end function

law "|a valid topic name keeps to its characters| is
  definition :
    for all (t :: Text where validTopic t) (n :: Int32 where n >= 1 && n <= 64) =>
      (prelude.length t >= 1 && prelude.length t <= 249 && n <= 64) = true end for all
  end definition
end law

law "|a unit may sit above its package's other units| is
  definition : for all (x :: Int32) => inner.doubled x = x + x end for all end definition
end law
end unit
