unit example.scalar_catalog

law "|Bool representation| is
  definition : for all (x :: Bool) => x = x end for all end definition
  example "|explicit value| : x = true expect x = true end example
end law

law "|Int8 representation| is
  definition : for all (x :: Int8) => x = x end for all end definition
  example "|explicit value| : x = -128 expect x = -128 end example
end law

law "|Int16 representation| is
  definition : for all (x :: Int16) => x = x end for all end definition
  example "|explicit value| : x = 32767 expect x = 32767 end example
end law

law "|Int32 representation| is
  definition : for all (x :: Int32) => x = x end for all end definition
  example "|explicit value| : x = 2147483647 expect x = 2147483647 end example
end law

law "|Int64 representation| is
  definition : for all (x :: Int64) => x = x end for all end definition
  example "|explicit value| : x = 9223372036854775807 expect x = 9223372036854775807 end example
end law

law "|UInt8 representation| is
  definition : for all (x :: UInt8) => x = x end for all end definition
  example "|explicit value| : x = 255 expect x = 255 end example
end law

law "|UInt16 representation| is
  definition : for all (x :: UInt16) => x = x end for all end definition
  example "|explicit value| : x = 65535 expect x = 65535 end example
end law

law "|UInt32 representation| is
  definition : for all (x :: UInt32) => x = x end for all end definition
  example "|explicit value| : x = 4294967295 expect x = 4294967295 end example
end law

law "|UInt64 representation| is
  definition : for all (x :: UInt64) => x = x end for all end definition
  example "|explicit value| : x = 18446744073709551615 expect x = 18446744073709551615 end example
end law

law "|IntSize representation| is
  definition : for all (x :: IntSize) => x = x end for all end definition
  example "|explicit value| : x = 2147483647 expect x = 2147483647 end example
end law

law "|UIntSize representation| is
  definition : for all (x :: UIntSize) => x = x end for all end definition
  example "|explicit value| : x = 4294967295 expect x = 4294967295 end example
end law

law "|UIntPtr representation| is
  definition : for all (x :: UIntPtr) => x = x end for all end definition
  example "|explicit value| : x = 4294967295 expect x = 4294967295 end example
end law

law "|BigInt representation| is
  definition : for all (x :: Integer) => x = x end for all end definition
  example "|explicit value| : x = -1234567890123456789012345678901234567890 expect x = -1234567890123456789012345678901234567890 end example
end law

law "|BigUInt representation| is
  definition : for all (x :: Whole) => x = x end for all end definition
  example "|explicit value| : x = 1234567890123456789012345678901234567890 expect x = 1234567890123456789012345678901234567890 end example
end law

law "|Decimal representation| is
  definition : for all (x :: Decimal) => x = x end for all end definition
  example "|explicit value| : x = 0.000000000000000000000000000000000001 expect x = 0.000000000000000000000000000000000001 end example
end law

law "|Rational representation| is
  definition : for all (x :: Rational) => x = x end for all end definition
  example "|explicit value| : x = rational(-7, 11) expect x = rational(-7, 11) end example
end law

law "|Float32 representation| is
  definition : for all (x :: Float32) => prelude.isNaN x = prelude.isNaN x end for all end definition
  example "|explicit value| : x = float32Bits("80000000") expect x = float32Bits("80000000") end example
end law

law "|Float64 representation| is
  definition : for all (x :: Float64) => prelude.isNaN x = prelude.isNaN x end for all end definition
  example "|explicit value| : x = float64Bits("7ff0000000000000") expect x = float64Bits("7ff0000000000000") end example
end law

law "|Complex64 representation| is
  definition : for all (x :: Complex64) => prelude.isNaN (prelude.real x) = prelude.isNaN (prelude.real x) end for all end definition
  example "|explicit value| : x = complex64(1, -2) expect x = complex64(1, -2) end example
end law

law "|Complex128 representation| is
  definition : for all (x :: Complex128) => prelude.isNaN (prelude.real x) = prelude.isNaN (prelude.real x) end for all end definition
  example "|explicit value| : x = complex128(0.5, -3.5) expect x = complex128(0.5, -3.5) end example
end law

law "|Char representation| is
  definition : for all (x :: Char) => x = x end for all end definition
  example "|explicit value| : x = char(128512) expect x = char(128512) end example
end law

law "|CodePoint representation| is
  definition : for all (x :: CodePoint) => x = x end for all end definition
  example "|explicit value| : x = codePoint(55296) expect x = codePoint(55296) end example
end law

law "|CodeUnit16 representation| is
  definition : for all (x :: CodeUnit16) => x = x end for all end definition
  example "|explicit value| : x = codeUnit16(65535) expect x = codeUnit16(65535) end example
end law

law "|Text representation| is
  definition : for all (x :: Text) => x = x end for all end definition
  example "|explicit value| : x = "λ日本語😀" expect x = "λ日本語😀" end example
end law

law "|CodePointText representation| is
  definition : for all (x :: CodePointText) => x = x end for all end definition
  example "|explicit value| : x = codePoints([55296, 1114111]) expect x = codePoints([55296, 1114111]) end example
end law

law "|Utf16Text representation| is
  definition : for all (x :: Utf16Text) => x = x end for all end definition
  example "|explicit value| : x = utf16([55296, 0, 65535]) expect x = utf16([55296, 0, 65535]) end example
end law

law "|Bytes representation| is
  definition : for all (x :: Bytes) => x = x end for all end definition
  example "|explicit value| : x = bytes([0, 128, 255]) expect x = bytes([0, 128, 255]) end example
end law

law "|Symbol representation| is
  definition : for all (x :: Symbol) => x = x end for all end definition
  example "|explicit value| : x = symbol("catalog", "same") expect x = symbol("catalog", "same") end example
end law

law "|Unit representation| is
  definition : for all (x :: Unit) => x = x end for all end definition
  example "|explicit value| : x = unitValue expect x = unitValue end example
end law

law "|Null representation| is
  definition : for all (x :: Null) => x = x end for all end definition
  example "|explicit value| : x = null expect x = null end example
end law

law "|Undefined representation| is
  definition : for all (x :: Undefined) => x = x end for all end definition
  example "|explicit value| : x = undefined expect x = undefined end example
end law

law "|Nullable Int8 representation| is
  definition : for all (x :: Nullable Int8) => x = x end for all end definition
  example "|explicit value| : x = nullable(127) expect x = nullable(127) end example
end law

law "|Optional Int8 representation| is
  definition : for all (x :: Optional Int8) => x = x end for all end definition
  example "|explicit value| : x = undefined expect x = undefined end example
end law
end unit
