cabal-version: 3.0
name: host-sdk-pilot
version: 0.1.0
build-type: Simple
executable host-sdk-pilot
  main-is: Main.hs
  hs-source-dirs: ../generated, .
  other-modules: Application, Host, Internal.Types
  build-depends: base < 5, lawspec, host-sdk-guest, text, bytestring, aeson, transformers, base64-bytestring == 1.2.1.0
  default-language: Haskell2010
  ghc-options: -no-hs-main -optl-mexec-model=reactor
