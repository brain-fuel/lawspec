{
  "name": "lawspec-language",
  "displayName": "LawSpec",
  "description": "LawSpec syntax, compiler diagnostics, formatting, outlines, hover and navigation.",
  "version": "0.1.0",
  "publisher": "brain-fuel",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brain-fuel/lawspec.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lawspec",
        "aliases": [
          "LawSpec",
          "lawspec"
        ],
        "extensions": [
          ".lawspec"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lawspec",
        "scopeName": "source.lawspec",
        "path": "./syntaxes/lawspec.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "LawSpec",
      "properties": {
        "lawspec.command": {
          "type": "string",
          "default": "lawspec",
          "description": "Path to the LawSpec CLI used for the language server."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onLanguage:lawspec"
  ],
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
