<?xml version="1.0" encoding="UTF-8"?>
<!--
  dev.goforge:lawspec-maven-plugin: a goal for every lawspec command. Each
  goal resolves this platform's dev.goforge:lawspec-<platform> jar of the
  plugin's version, unpacks and verifies its binary through the launcher and
  runs it in the project directory. ref:DEC-jvm-native-host
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.goforge</groupId>
    <artifactId>lawspec-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>lawspec-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <name>LawSpec Maven plugin</name>
  <description>Runs LawSpec's check, generate, test, prove and every other command from Maven.</description>

  <prerequisites>
    <maven>3.9.0</maven>
  </prerequisites>

  <dependencies>
    <dependency>
      <groupId>dev.goforge</groupId>
      <artifactId>lawspec</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Reads the targets lawspec describe reports, for the generated directories. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.13.2</version>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${plugin-tools.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-api</artifactId>
      <version>${resolver.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>javax.inject</groupId>
      <artifactId>javax.inject</artifactId>
      <version>1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <configuration>
          <goalPrefix>lawspec</goalPrefix>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
