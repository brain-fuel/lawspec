<?xml version="1.0" encoding="UTF-8"?>
<!-- The natively compiled lawspec for macOS on Apple silicon (arm64). ref:DEC-jvm-native-host -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.goforge</groupId>
    <artifactId>lawspec-platform-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>lawspec-darwin-arm64</artifactId>
  <name>LawSpec darwin-arm64</name>
  <description>The natively compiled LawSpec CLI for macOS on Apple silicon (arm64).</description>

  <properties>
    <lawspec.platform>darwin-arm64</lawspec.platform>
  </properties>

  <build>
    <resources>
      <resource>
        <directory>${lawspec.natives}/${lawspec.platform}</directory>
        <targetPath>dev/goforge/lawspec/native/${lawspec.platform}</targetPath>
        <includes>
          <include>lawspec</include>
          <include>canon/canon</include>
          <include>canon/canon.json</include>
          <include>canon/presets/**</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
