cabal-version: 3.0
name: lawspec-wasm
version: 0.2.1
build-type: Simple
executable lawspec-wasm
  main-is: Exports.hs
  hs-source-dirs: app
  build-depends: base < 5, lawspec, text, bytestring, ghc-experimental
  default-language: Haskell2010
  ghc-options: -Wall -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=lawspec_call"
