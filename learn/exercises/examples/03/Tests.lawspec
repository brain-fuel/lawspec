-- ref:DEC-learn-tests-in-lawspec
unit learn.seats
seats :: Int32 -> Int32

law "|one row has four seats| is
  definition:
    seats 1 = 4
  end definition
end law

law "|two rows have eight seats| is
  definition:
    seats 2 = 8
  end definition
end law

law "|three rows have twelve seats| is
  definition:
    seats 3 = 12
  end definition
end law

law "|every row contributes four seats| is
  definition:
    for all (rows :: Int32 where rows >= 0 and rows <= 40) =>
      seats rows = rows * 4
    end for all
  end definition
end law

end unit
