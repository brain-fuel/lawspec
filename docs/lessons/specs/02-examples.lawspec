unit lessons.pricing

-- The price of an order in cents: 250 per drink, or 225 per drink for ten or
-- more.
priceInCents :: Int32 -> Int64

law "|drinks cost 250 cents each below ten| is
  definition :
    for all (q :: Int32) =>
      q >= 0 && q < 10 implies priceInCents q = q * 250 end for all
  end definition

  example "|nothing ordered| :
    q = 0
    expect priceInCents q = 0
  end example

  example "|one coffee| :
    q = 1
    expect priceInCents q = 250
  end example
end law

law "|ten or more drinks are discounted| is
  definition :
    for all (q :: Int32) =>
      q >= 10 && q <= 1000 implies priceInCents q = q * 225 end for all
  end definition

  example "|a tray of ten| :
    q = 10
    expect priceInCents q = 2250
  end example
end law
end unit
