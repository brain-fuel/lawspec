unit lessons.money

-- A small library of money types and laws, shared by other units.
refinement Cents is (c :: Int64 where c >= 0 && c <= 10000000) end

definition dollars (n :: Int32) :: BigInt is n * 100 end

law `never more than` (f :: a -> a -> a) requires Ordered a is
  definition is
    `for all` (x :: a) (y :: a) . f x y <= x && f x y <= y
  end
end
