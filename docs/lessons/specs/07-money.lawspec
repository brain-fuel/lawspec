unit lessons.money

-- A small library of money types and laws, shared by other units.
refinement Cents is (c :: Int64 where c >= 0 && c <= 10000000) end refinement

function dollars (n :: Int32) -> Integer is n * 100 end function

law "|never more than| (f :: a -> a -> a) requires Ordered a is
  definition :
    for all (x :: a) (y :: a) => f x y <= x && f x y <= y end for all
  end definition
end law
end unit
