unit example.adequacy

number :: Int32 -> Int32
dependent :: Int32 -> Int32 -> Int32
finite :: Bool -> Bool

function bucket (n :: Int32) -> Text is
  if n < 5 then "small" else "large" end if
end function

law "|generated observations| is
  definition : for all (n :: Int32 where n > 0) => number n = n end for all end definition
  example "|examples do not count| : n = 101 expect n = 101 end example
end law

law "|dependent observations| is
  definition :
    for all (x :: Int32) (y :: Int32 where y > x && y <= x + 10) => dependent x y = y end for all
  end definition
end law

law "|finite observations| is
  definition : for all (flag :: Bool) => finite flag = flag end for all end definition
  example "|finite example| : flag = true expect flag = true end example
end law

harness example.adequacy.testing for example.adequacy is
  strategy digits :: Int32 is one of 1, 9 end strategy
  strategy starts :: Int32 is one of 3, 7 end strategy

  for law "|generated observations|
    use digits for n
    cover 100% "positive" when n > 0
    cover 0% "positive" when n < 0
    classify n > 0 as "positive"
    classify n > 0 as "positive"
    classify n < 0 as "never"
    label bucket n
    label "雪/é"
    label "雪/é"

  end for law
for law "|dependent observations|
    use starts for x
    cover 100% "above its prefix" when y > x
    classify y <= x + 10 as "bounded"
    label "dependent"

  end for law
for law "|finite observations|
    classify flag as "true flag"
    label "finite"
end for law
end harness
end unit
