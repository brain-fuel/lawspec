unit example.rc1.siblingEffects

ability Signal is
  signal of type Bool -> Bool
end ability

handler echo for Signal is
  operation signal value is value end operation
end handler

procedure read (value of type Bool) -> Bool uses Signal is
  signal value
end procedure

law "|local binding preserves the chosen handler| using echo is
  definition:
    (for all (read of type Bool) =>
      read must be read
    end for all)
    and read true must be true
  end definition
end law
end unit
