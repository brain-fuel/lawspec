unit native.codec_generators

import native.codecs (Parcel, Positive)

-- The original examples have finite domains and deliberately enumerate them
-- without calling factories. These infinite domains exercise the factories.
law "|wide parcels use native factories| is
  definition : for all (x :: Parcel Int32) => x = x end for all end definition
end law

law "|positive lists use native factories| is
  definition : for all (xs :: List Positive) => xs = xs end for all end definition
end law
end unit
