unit example.strategies

type Parcel is a record{  base :: Int32 upper :: Int32} end type

numbers :: Int32 -> Int32
parcels :: Parcel -> Parcel
dependent :: Int32 -> Int32 -> Int32
defaults :: Int32 -> Int32
wide :: Integer -> Integer
finite :: Bool -> Bool
shadowed :: Int32 -> Int32

law "|weighted refined numbers| is
  definition : for all (n :: Int32 where n > 0) => numbers n = n end for all end definition
  example "|examples are outside the strategy| : n = 101 expect n = 101 end example
end law

law "|bound record fields| is
  definition : for all (p :: Parcel) => parcels p = p end for all end definition
  example "|explicit record example| : p = Parcel record{ base = 0 , upper = 0} expect p = Parcel record{ base = 0 , upper = 0} end example
end law

law "|dependent input bounds| is
  definition :
    for all (x :: Int32) (y :: Int32 where y > x && y <= x + 10) => dependent x y = y end for all
  end definition
end law

law "|default any respects the input| is
  definition : for all (n :: Int32 where n >= 100 && n <= 110) => defaults n = n end for all end definition
end law

law "|wide strategy bounds| is
  definition : for all (n :: Integer where n > 0) => wide n = n end for all end definition
end law

law "|finite domains remain exhaustive| is
  definition : for all (flag :: Bool) => finite flag = flag end for all end definition
  example "|explicit finite example| : flag = true expect flag = true end example
end law

law "|strategy binders shadow locally| is
  definition : for all (n :: Int32) => shadowed n = n end for all end definition
end law

harness example.strategies.testing for example.strategies is
  strategy digits :: (n :: Int32 where n >= 1 && n <= 9) is
    any such that prelude.rem it 2 = 1 at most 50 discards
  end strategy
  strategy spikes :: Int32 is one of 1, 9 end strategy
  strategy numbers :: Int32 is frequency 3 digits, 1 spikes end strategy
  strategy records :: Parcel is
    bind base :: Int32 from (one of 1, 2, 3) in one of Parcel record{ base = base , upper = (base + 1)}, Parcel record{ base = base , upper = (base + 2)} end bind
  end strategy
  strategy starts :: Int32 is one of 5, 7 end strategy
  strategy automatic :: Int32 is any end strategy
  strategy wideNumbers :: (n :: Integer where
    n >= 340282366920938463463374607431768211456 &&
    n <= 340282366920938463463374607431768211465) is any end strategy
  strategy neverDrawn :: Bool is any such that false at most 1 discards end strategy
  strategy shadowing :: Int32 is
    bind value :: Int32 from (one of 2) in
      bind value :: Int32 from (one of value + 1) in one of value * 2 end bind end bind
  end strategy

  for law "|weighted refined numbers|
    use numbers for n
  end for law
for law "|bound record fields|
    use records for p
  end for law
for law "|dependent input bounds|
    use starts for x
    use automatic for y
  end for law
for law "|default any respects the input|
    use automatic for n
  end for law
for law "|wide strategy bounds|
    use wideNumbers for n
  end for law
for law "|finite domains remain exhaustive|
    use neverDrawn for flag
  end for law
for law "|strategy binders shadow locally|
    use shadowing for n
end for law
end harness
end unit
