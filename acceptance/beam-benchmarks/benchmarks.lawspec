unit example.benchmarks

ordinary :: Int32 -> Int32
work :: Int32 -> Int32
async asyncWork :: Int32 -> Int32
falseValue :: Unit -> Bool

function checked (n :: Int32) -> Int32 is n end function

ability Meter is
  read :: Unit -> Int32
end ability

procedure measured (u :: Unit) -> Int32 uses Meter is read u end procedure

law "|ordinary check| is definition : ordinary 99 = 99 end definition end law

harness example.benchmarks.testing for example.benchmarks is
  benchmark `checked adapter` is work (checked 7) end benchmark
  benchmark `async adapter` is asyncWork 8 end benchmark
  benchmark `false is a value` is falseValue unitValue end benchmark
  benchmark `production handler` is measured unitValue end benchmark
end harness
end unit
