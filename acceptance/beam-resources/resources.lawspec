unit example.beamResources

handle Store
openStore :: Unit -> Store
closeStore :: Store -> Unit
size :: Store -> Int32
write :: Store -> Int32 -> Bool
isOpen :: Store -> Bool

resource Store is
  acquire is openStore unitValue end acquire
  release store is closeStore store end release
end resource

law "|fresh stores| for first :: Store, second :: Store is
  definition :
    for all (n :: Int32) =>
      size first = 0 and size second = 0 and write second n end for all
  end definition
  example "|expectations run before release| :
    n = 12
    expect isOpen first
    expect isOpen second
    expect size second = 1
  end example
end law

directoryEmpty :: Text -> Bool
writeNote :: Text -> Int32 -> Bool
noteMatches :: Text -> Int32 -> Bool
fileEmpty :: Text -> Bool

law "|a directory belongs to its case| for dir :: TemporaryDirectory is
  definition :
    for all (n :: Int32) =>
      directoryEmpty (directoryPath dir) and writeNote (directoryPath dir) n and noteMatches (directoryPath dir) n end for all
  end definition
end law

law "|a temporary file starts empty| for file :: TemporaryFile is
  definition : fileEmpty (filePath file) end definition
end law

setGreeting :: Int32 -> Bool
greetingMatches :: Int32 -> Bool
greetingAbsent :: Unit -> Bool

law "|the environment is fresh| for saved :: SavedEnvironment is
  definition :
    for all (n :: Int32) => greetingAbsent unitValue and setGreeting n and greetingMatches n end for all
  end definition
end law

law "|the environment is restored| for saved :: SavedEnvironment is
  definition : greetingAbsent unitValue end definition
end law
end unit
