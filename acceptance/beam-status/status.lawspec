unit example.status

ordinary :: Bool -> Bool
skipped :: Int32 -> Int32
propertyBug :: Int32 -> Int32
exampleBug :: Int32 -> Int32
finiteBug :: Bool -> Bool
scoredBug :: Int32 -> Int32

handle Guard
openGuard :: Unit -> Guard
closeGuard :: Guard -> Unit
guardLive :: Guard -> Bool
resource Guard is
  acquire is openGuard unitValue end acquire
  release guard is closeGuard guard end release
end resource

law "|ordinary checks| is
  definition : for all (flag :: Bool) => ordinary flag = flag end for all end definition
end law

law "|skipped completely| for guard :: Guard is
  definition : for all (n :: Int32) => guardLive guard and skipped n = n end for all end definition
  example "|also skipped| : n = 9 expect skipped n = 9 end example
end law

law "|known property failure| is
  definition : for all (n :: Int32 where n >= 0 && n <= 1000) => propertyBug n = n end for all end definition
  example "|passes first| : n = 1 expect n = 1 end example
end law

law "|known example failure| is
  definition : for all (n :: Int32) => exampleBug n = n end for all end definition
  example "|fails first| : n = 9 expect n = 9 end example
end law

law "|known finite failure| is
  definition : for all (flag :: Bool) => finiteBug flag = flag end for all end definition
end law

law "|known scored failure| is
  definition : for all (n :: Int32 where n >= 0 && n <= 1000) => scoredBug n = n end for all end definition
end law

harness example.status.testing for example.status is
  strategy zero :: Int32 is one of 0 end strategy
  strategy seven :: Int32 is one of 7 end strategy

  for law "|skipped completely|
    skip "not implemented; issue 雪-1"
    repeat 3
    cover 100% "never generated" when n > 0

  end for law
for law "|known property failure|
    use seven for n
    known failing "issue 2"
    cover 100% "seven" when n = 7

  end for law
for law "|known example failure|
    known failing "issue 3"

  end for law
for law "|known finite failure|
    known failing "issue 4"

  end for law
for law "|known scored failure|
    use seven for n
    known failing "issue 5"
    cover 100% "ordinary roots" when n = 7
    target maximize (0 - (n - 137) * (n - 137))
end for law
end harness
end unit
