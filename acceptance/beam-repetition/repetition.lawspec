unit example.repetition

number :: Int32 -> Int32
finite :: Bool -> Bool
transient :: Unit -> Bool
peak :: Int32 -> Int32

law "|repeated random cases| is
  definition : for all (n :: Int32 where n >= 0 && n <= 1000) => number n = n end for all end definition
  example "|repeated example| : n = 500 expect n = 500 end example
end law

law "|repeated finite cases| is
  definition : for all (flag :: Bool) => finite flag = flag end for all end definition
  example "|finite example| : flag = true expect flag = true end example
end law

law "|transient failure| is
  definition : transient unitValue end definition
end law

law "|repeated search| is
  definition : for all (n :: Int32 where n >= 0 && n <= 1000) => peak n = n end for all end definition
end law

harness example.repetition.testing for example.repetition is
  strategy zero :: Int32 is one of 0 end strategy

  for law "|repeated random cases|
    use zero for n
    repeat 3
    retry flaky 2
    cover 100% "ordinary roots" when n = 0

  end for law
for law "|repeated finite cases|
    repeat 3

  end for law
for law "|transient failure|
    repeat 2
    retry flaky 1

  end for law
for law "|repeated search|
    use zero for n
    repeat 2
    cover 100% "ordinary roots" when n = 0
    target maximize (0 - (n - 137) * (n - 137))
end for law
end harness
end unit
