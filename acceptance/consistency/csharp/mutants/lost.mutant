    public static long Hit(Views views)
    {
        Dictionary<int, long> mine;
        long seen;
        lock (gate)
        {
            mine = replicas[views.Id];
            seen = mine.Values.Sum();
        }
        System.Threading.Thread.Sleep(1);
        lock (gate)
        {
            mine.Clear();
            mine[0] = seen + 1;
            return seen + 1;
        }
    }
