    public static long Hit(Views views)
    {
        lock (gate)
        {
            var mine = replicas[views.Id];
            var me = Environment.CurrentManagedThreadId;
            var count = mine.GetValueOrDefault(me) + 1;
            mine[me] = count;
            return count;
        }
