unit example.selectionA
observed :: Int32 -> Int32
law "|check| is definition : observed 1 = 1 end definition end law
law "|check extra| is definition : observed 10 = 10 end definition end law
law "|雪| is definition : observed 20 = 20 end definition end law
law "|雲| is definition : observed 21 = 21 end definition end law
harness example.selectionA.testing for example.selectionA is
  order random
  parallel
end harness
end unit
