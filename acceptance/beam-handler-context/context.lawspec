unit example.handlerContext

ability Counter is
  bump :: Int32 -> Integer
  current :: Integer
end ability

ability Offset is
  offset :: Int32
end ability

handler hundredOffset for Offset is
  operation offset is 100 end operation
end handler

handler freshCounter for Counter with state total :: Integer start 0 is
  operation bump amount is ~total := total + amount; total end operation
  operation current is total + offset end operation
end handler

procedure advance (amount :: Int32) -> Integer uses Counter is bump amount end procedure

-- The native adapter receives Counter from the outer scope, then calls this
-- public definition. Its nested Offset must reach Counter's spec clause.
procedure shifted (amount :: Int32) -> Integer uses Counter is
  handle bump amount; current with hundredOffset end handle
end procedure

roundtrip :: Int32 -> Integer uses Counter
async asyncRoundtrip :: Int32 -> Integer uses Counter
publicProbe :: Unit -> Bool

law "|a native round trip retains lexical overrides| using freshCounter is
  definition :
    for all (amount :: Int32 where amount >= -1000 && amount <= 1000) =>
      roundtrip amount = amount + 100 end for all
  end definition
end law

law "|an async worker retains handlers and can allocate scoped state| using freshCounter is
  definition :
    for all (amount :: Int32 where amount >= -1000 && amount <= 1000) =>
      asyncRoundtrip amount = amount + 100 end for all
  end definition
end law

law "|cases have fresh state and examples share recordings| using recording Counter is
  definition :
    for all (amount :: Int32 where amount >= -1000 && amount <= 1000) =>
      (current = 0 && bump amount = amount && calls of bump = 1) = true end for all
  end definition
  example "|one recorded call| :
    amount = 7
    expect calls of bump = 1
  end example
end law

law "|public constructors and definitions share their context| is
  definition : publicProbe unitValue = true end definition
end law
end unit
