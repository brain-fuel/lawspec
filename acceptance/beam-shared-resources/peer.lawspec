unit example.sharedPeer

import example.sharedTypes (SharedPool)

openPool :: Unit -> SharedPool
resetPool :: SharedPool -> Unit
closePool :: SharedPool -> Unit
usePool :: SharedPool -> Bool

resource SharedPool is
  acquire is openPool unitValue end acquire
  release pool is closePool pool end release
  reset pool is resetPool pool end reset
end resource

law "|another unit shares the run resource| for pool :: SharedPool is
  definition : usePool pool end definition
end law

harness example.sharedPeer.testing for example.sharedPeer is
  share SharedPool per run
end harness
end unit
