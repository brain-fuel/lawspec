unit example.actor_abilities

ability Factor is
  adjust :: UInt8 -> Int64
end

ability Restore is
  restore :: Int64 -> Int64
end

type Counter is Counter value :: Int64 end
async openCounter :: Unit -> Counter
async add :: Counter -> UInt8 -> Pair Int64 Counter uses Factor
total :: Counter -> Pair Int64 Counter
reopen :: Counter -> Counter uses Restore

definition modelAdd (amount :: UInt8) (n :: Int64 where n >= 0 && n <= 1000000) :: Pair Int64 Int64 is
  Pair (n + 2 * amount) (n + 2 * amount)
end
definition modelTotal (n :: Int64) :: Pair Int64 Int64 is Pair n n end
definition modelReopen (n :: Int64 where n >= 0 && n <= 1000000) :: Int64 is n + 10 end

actor counter :: Counter by Int64 is
  start openCounter by 0
  restart from reopen by modelReopen
  on add by modelAdd
  on total by modelTotal
end

supervisor bank is
  one for one
  permanent counter
end
supervisor root is
  one for one
  permanent bank
end

nativeProbe :: Unit -> Bool
law `typed actors keep their ability choices through native async and restarts` is
  definition is nativeProbe unitValue end
end
