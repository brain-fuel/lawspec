unit example.actor_abilities

ability Factor is
  adjust :: UInt8 -> Int64
end ability

ability Restore is
  restore :: Int64 -> Int64
end ability

type Counter is a record{  value :: Int64} end type
async openCounter :: Unit -> Counter
async add :: Counter -> UInt8 -> Pair Int64 Counter uses Factor
total :: Counter -> Pair Int64 Counter
clear :: Counter -> Counter
echo :: Counter -> Maybe (List Int32) -> Pair (Maybe (List Int32)) Counter
reopen :: Counter -> Counter uses Restore

function modelAdd (amount :: UInt8) (n :: Int64 where n >= 0 && n <= 1000000) -> Pair Int64 Int64 is
  Pair (n + 2 * amount) (n + 2 * amount)
end function
function modelTotal (n :: Int64) -> Pair Int64 Int64 is Pair n n end function
function modelClear (n :: Int64) -> Int64 is 0 end function
function modelEcho (value :: Maybe (List Int32)) (n :: Int64) -> Pair (Maybe (List Int32)) Int64 is Pair value n end function
function modelReopen (n :: Int64 where n >= 0 && n <= 1000000) -> Int64 is n + 10 end function

actor counter :: Counter by Int64 is
  start openCounter by 0
  restart from reopen by modelReopen
  on add by modelAdd
  on total by modelTotal
  on clear by modelClear
  on echo by modelEcho
end actor

supervisor bank is
  one for one
  permanent counter
end supervisor
supervisor root is
  one for one
  permanent bank
end supervisor

nativeProbe :: Unit -> Bool
law "|typed actors keep their ability choices through native async and restarts| is
  definition : nativeProbe unitValue end definition
end law

remoteProbe :: Unit -> Bool
law "|remote actors retain server abilities and stable handles across restarts| is
  definition : remoteProbe unitValue end definition
end law
end unit
