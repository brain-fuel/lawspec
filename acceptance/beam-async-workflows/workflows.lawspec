unit example.asyncWorkflows

ability Coordination is
  meet :: Int32 -> Unit
  finish :: Int32 -> Unit
end ability

async first :: Int8 -> Either Text Int8 uses Coordination
async second :: Int8 -> Either Text Int8 uses Coordination

function keepFirst (a :: Int8) (b :: Int8) -> Int8 is a end function

workflow both :: Int8 -> Either _ Int8 is
  all accumulate
    then first
    then second
  end all
  combine keepFirst
end workflow

workflow firstFailure :: Int8 -> Either _ Int8 is
  all
    then first
    then second
  end all
  combine keepFirst
end workflow

law "|parallel results keep declaration order| is
  definition : for all (n :: Int8) =>
    both n = prelude.select (n < 0)
      (Left (BothFailures [BothFirstFailed "first", BothSecondFailed "second"]))
      (Right n) end for all
  end definition
end law

law "|without accumulation the first declared failure wins| is
  definition : for all (n :: Int8) =>
    firstFailure n = prelude.select (n < 0) (Left (FirstFailureFirstFailed "first")) (Right n) end for all
  end definition
end law

publicProbe :: Unit -> Bool
law "|public workflow steps overlap and all finish before returning| is
  definition : publicProbe unitValue = true end definition
end law
end unit
