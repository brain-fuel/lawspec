unit example.embedding

-- An application makes spec handlers itself, outside any law: it takes an
-- operation's failure as a value, reads and replaces a handler's state in
-- its native types, and gets one interface per ability of a handler of
-- several abilities, all answered from one state.

type Refusal is one of | Negative | TooLarge end type

ability Tally is
  add :: Int64 -> Int64 fails with Refusal
end ability

procedure bump (n :: Int64) (total :: Int64) -> Pair Int64 Int64 fails with Refusal is
  if n < 0 then raise Negative else
    if total > 1000000 || n > 1000000 then Pair total total else Pair (prelude.Int64 (total + n)) (prelude.Int64 (total + n)) end if end if
end procedure

handler keeping for Tally with state total :: Int64 start 0 is
  operation add by bump end operation
end handler

ability Ledger is
  record :: Int64 -> Unit
end ability

ability Balance is
  balance :: Int64
end ability

handler book for Ledger, Balance with state sum :: Int64 start 0 is
  operation record n is
    ~sum := (if n >= 0 && n <= 1000000 && sum <= 1000000 - n then prelude.Int64 (sum + n) else sum end if); unitValue
  end operation
  operation balance is sum end operation
end handler

embed :: Int64 -> Int64
shareBook :: Int64 -> Int64

law "|an embedded handler takes failures as values and keeps its state| is
  definition : for all (n :: Int64 where n >= 0 && n <= 1000) => embed n = 10 + n end for all end definition
end law

law "|a handler of several abilities shares its state natively| is
  definition : for all (n :: Int64 where n >= 0 && n <= 1000) => shareBook n = n end for all end definition
end law
end unit
