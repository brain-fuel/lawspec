unit example.beamFailures

type Rejection is one of
  | Declined of type record{ message :: Text}
  | Blocked
  | Limit  of type Int32
end type

refund :: Int32 -> Int32 fails with Rejection
async checkedLimit :: Int32 -> Int32 fails with Rejection

procedure limit (n :: Int32) -> Int32 fails with Rejection is
  if n < 0 then raise Blocked else
    if n > 5000 then raise (Limit 5000) else n end if end if
end procedure

law "|native failures carry their message| is
  definition : for all (n :: Int32 where n < 0) =>
    refund n fails with Declined record{ message = _} message contains "negative" end for all
  end definition
  example "|minus one| :
    n = -1
    expect prelude.attempt (refund n) = Left (Declined record{ message = "negative refund"})
  end example
end law

law "|native failures retain their fields| is
  definition : for all (n :: Int32 where n > 5000) =>
    refund n fails with Limit 5000 end for all
  end definition
end law

law "|native successes become Right| is
  definition : for all (n :: Int32 where n >= 0 && n <= 5000) =>
    prelude.attempt (refund n) = Right n end for all
  end definition
end law

law "|checked definitions and public native wrappers agree| is
  definition : for all (n :: Int32) =>
    prelude.attempt (checkedLimit n) = prelude.attempt (limit n) end for all
  end definition
end law

law "|failure patterns distinguish constructors| is
  definition : for all (n :: Int32 where n < 0) =>
    checkedLimit n fails with Blocked && !(checkedLimit n fails with Declined record{ message = _}) end for all
  end definition
end law
end unit
