poll (Data.WorkQueue identity) = do
  box <- get queues identity Seq.empty
  items <- readMVar box
  case viewl items of
    EmptyL -> pure Nothing
    front :< _ -> do
      threadDelay 1000
      with queues identity Seq.empty $ \now -> (Seq.drop 1 now, ())
      pure (Just front)
